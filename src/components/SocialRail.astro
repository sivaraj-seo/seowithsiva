const hostKey = (url: string) => {
  const h = new URL(url).hostname;
  return h.includes('linkedin') ? 'linkedin' : h.includes('x.com') || h.includes('twitter') ? 'x' : h.includes('reddit') ? 'reddit' : h.includes('instagram') ? 'instagram' : null;
};
// WhatsApp is a contact link, not a profile, so it lives here rather than in socialLinks (which feeds schema sameAs).
const whatsappUrl = 'https://wa.link/l9kdx1';
const items = [
  ...socialLinks.map((url) => ({ url, key: hostKey(url) })).filter((i) => i.key),
  { url: whatsappUrl, key: 'whatsapp' },
];
---

<nav class="social-rail" aria-label="Social media profiles">
  {items.map(({ url, key }) => (
    <a href={url} target="_blank" rel="noopener noreferrer me" aria-label={icons[key].label} title={icons[key].label}>
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
        <path fill="currentColor" d={icons[key].path} />
      </svg>
    </a>
  ))}
</nav>

<style>
  .social-rail {
    position: fixed;
    left: 16px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: none;
    flex-direction: column;
    gap: 12px;
  }
  .social-rail a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    color: #fff;
    background: var(--primary);
    box-shadow: 0 4px 12px rgba(24, 119, 242, 0.3);
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
  }
  .social-rail a:hover,
  .social-rail a:focus-visible {
    background: var(--primary-dark);
    transform: translateY(-2px) scale(1.08);
    box-shadow: 0 8px 18px rgba(24, 119, 242, 0.4);
  }
  .social-rail a:focus-visible {
    outline: 2px solid var(--primary-dark);
    outline-offset: 3px;
  }
  /* Only show where there is margin beside the content column */
  @media (min-width: 1360px) {
    .social-rail {
      display: flex;
    }
  }
  @media print {
    .social-rail {
      display: none;
    }
  }
</style>
