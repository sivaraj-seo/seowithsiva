        <div class="footer-col">
          <p class="fc-title">Services</p>
          <a href="/#services">AI Search (AEO / GEO)</a>
          <a href="/#services">Enterprise SEO</a>
          <a href="/#services">Technical SEO</a>
          <a href="/#services">Content Strategy</a>
