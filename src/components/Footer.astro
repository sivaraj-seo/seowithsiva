<style>
  .site-footer {
    padding: 40px 24px 28px;
    background: var(--canvas);
  }
  .footer-panel {
    max-width: 1136px;
    margin: 0 auto;
    background: var(--surface);
    border-radius: 28px;
    padding: 40px 48px 24px;
  }
  .footer-top {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .footer-brief {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 40px;
    align-items: center;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .footer-brief > .fb-title,
  .footer-brief > p:not(.fb-title) { grid-column: 1; }
  .footer-brief > .footer-pref { grid-column: 2; grid-row: 1 / span 2; }
  .fb-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .footer-brief p:not(.fb-title) {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
    margin: 8px 0 0;
    max-width: 52ch;
  }
  .footer-brief p a { color: var(--primary); text-decoration: none; }
  .footer-pref { margin-top: 0; display: flex; flex-direction: row; align-items: center; gap: 14px; }
  .footer-brief p.fp-label {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--muted);
    margin: 0;
  }
  .fp-btn { min-height: 40px; }
  .footer-cols {
    display: grid;
    grid-template-columns: 1.5fr repeat(4, 1fr);
    gap: 32px 28px;
    align-items: start;
  }
  .footer-col { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .footer-col .fc-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .footer-col a, .footer-col span {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color .15s;
  }
  .footer-col a:hover { color: var(--primary); }
  .footer-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-top: 28px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
    flex-wrap: wrap;
  }
  .footer-copy { font-size: 12px; color: var(--muted); }

  @media (max-width: 900px) {
    .footer-brief { grid-template-columns: 1fr; }
    .footer-brief > .footer-pref { grid-column: 1; grid-row: auto; margin-top: 14px; flex-wrap: wrap; }
    .footer-cols { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 560px) {
    .site-footer { padding: 24px 14px 18px; }
    .footer-panel { padding: 28px 22px 20px; border-radius: 22px; }
    .footer-cols { grid-template-columns: repeat(2, 1fr); }
  }
</style>
