<style>
  .site-footer {
    padding: 40px 24px 28px;
    background: var(--canvas);
  }
  .footer-panel {
    max-width: 1136px;
    margin: 0 auto;
    background: var(--surface);
    border-radius: 28px;
    padding: 56px 56px 40px;
  }
  .footer-top {
    display: grid;
    grid-template-columns: 1.1fr 2fr;
    gap: 56px;
  }
  .fb-title {
    font-size: 15px;
    font-weight: 700;
    color: var(--ink);
    margin: 0;
  }
  .footer-brief p:not(.fb-title) {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--muted);
    margin: 10px 0 22px;
    max-width: 34ch;
  }
  .footer-brief p a { color: var(--primary); text-decoration: none; }
  .footer-subscribe {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 6px 6px 6px 20px;
    max-width: 340px;
  }
  .fs-main { font-size: 13.5px; color: var(--ink); text-decoration: none; font-weight: 500; }
  .fs-btn {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--primary);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .footer-cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.2fr 1fr;
    gap: 28px;
  }
  .footer-col { display: flex; flex-direction: column; gap: 10px; min-width: 0; }
  .footer-col .fc-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--ink);
    margin: 0 0 6px;
  }
  .footer-col a, .footer-col span {
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color .15s;
  }
  .footer-col a:hover { color: var(--primary); }
  .footer-bottom {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
    flex-wrap: wrap;
  }
  .footer-name {
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    letter-spacing: -.035em;
    line-height: 1;
    color: var(--ink);
  }
  .footer-copy { font-size: 12px; color: var(--muted); }

  @media (max-width: 900px) {
    .footer-top { grid-template-columns: 1fr; gap: 40px; }
    .footer-cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .site-footer { padding: 24px 14px 18px; }
    .footer-panel { padding: 36px 22px 28px; border-radius: 22px; }
  }
</style>
