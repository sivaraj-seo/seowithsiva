---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { safeJsonLd } from '../../utils/schema';
import { getImageDims } from '../../data/imageDims';

const allArticles = await getCollection('articles');
const articles = allArticles.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

const categories = [...new Set(articles.map(a => a.data.category))];

const collectionPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Blog on SEO, GEO & AEO',
  description: 'Field notes on AI search optimisation, Generative Engine Optimisation, Answer Engine Optimisation, and enterprise SEO strategy - by C. Sivaraj.',
  url: 'https://www.seowithsiva.com/blog/',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/blog/${article.slug}/`, Astro.site).toString(),
      name: article.data.title,
    })),
  },
};
---

<BaseLayout
  title="Blog on SEO, GEO & AEO"
  description="Field notes on AI search optimisation, Generative Engine Optimisation, Answer Engine Optimisation, and enterprise SEO strategy - by C. Sivaraj."
  keywords="SEO blog, GEO, AEO, AI search, content strategy, enterprise SEO"
  author="C. Sivaraj"
>

<Fragment slot="head">
  <script type="application/ld+json" set:html={safeJsonLd(collectionPageSchema)} />
</Fragment>

<style>
  a { color: inherit; text-decoration: none; }
  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 32px; }

  .tag { display: inline-block; font-size: 12px; color: var(--muted); letter-spacing: .02em; }
  .tag::before { content: '['; }
  .tag::after { content: ']'; }

  /* ── HERO ── */
  .page-hero { padding: 24px 0 0; }
  .page-hero .hero-panel {
    background: linear-gradient(180deg, var(--primary-light), var(--surface));
    border-radius: 28px; padding: 64px 32px 120px; text-align: center; position: relative; overflow: hidden;
  }
  .hero-panel::before {
    content: 'Blog'; position: absolute; left: 50%; bottom: -.18em; transform: translateX(-50%);
    font-size: clamp(120px, 15vw, 200px); font-weight: 700; letter-spacing: -.06em; line-height: 1;
    color: rgba(24,119,242,.06); pointer-events: none;
  }
  .page-hero h1 {
    position: relative; font-weight: 600; font-size: clamp(32px, 4.6vw, 54px);
    color: var(--ink); margin-top: 14px; letter-spacing: -.03em; line-height: 1.1;
  }
  .page-hero h1 span { color: var(--primary); }
  .page-hero p { position: relative; font-size: 15px; line-height: 1.7; color: var(--muted); margin: 16px auto 0; max-width: 52ch; }
  .clouds { display: none; }

  /* ── FILTER PILLS ── */
  .filters { display: flex; gap: 8px; flex-wrap: wrap; padding: 40px 0 28px; }
  .filter-btn {
    padding: 9px 18px; border-radius: 999px; font: inherit; font-size: 13.5px; font-weight: 600;
    cursor: pointer; border: 1px solid var(--border); background: #fff; color: var(--ink-light);
    transition: background .15s, color .15s, border-color .15s;
  }
  .filter-btn:hover { border-color: var(--primary); color: var(--primary); }
  .filter-btn.active { background: var(--primary); border-color: var(--primary); color: #fff; }

  /* ── GRID ── */
  .articles-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; padding-bottom: 90px; }
  .art-card {
    display: flex; flex-direction: column;
    background: var(--surface); border-radius: 22px; overflow: hidden;
    transition: transform .2s, box-shadow .2s;
  }
  .art-card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -24px rgba(17,20,24,.35); }
  .art-thumb { position: relative; }
  .art-thumb img { width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; display: block; }
  .art-cat-badge {
    position: absolute; top: 12px; left: 12px;
    background: rgba(255,255,255,.92); backdrop-filter: blur(6px);
    padding: 5px 11px; border-radius: 999px;
    font-size: 11.5px; font-weight: 600; color: var(--ink);
  }
  .art-body { padding: 22px 24px 26px; display: flex; flex-direction: column; flex: 1; }
  .art-meta { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); }
  .art-meta-dot { width: 3px; height: 3px; border-radius: 50%; background: var(--muted); }
  .art-body h2 { font-size: 17px; font-weight: 600; margin: 12px 0 0; line-height: 1.35; color: var(--ink); letter-spacing: -.015em; }
  .art-body p { font-size: 13.5px; line-height: 1.65; color: var(--muted); margin: 10px 0 0; flex: 1; }
  .art-footer { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
  .read-btn {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 9px 16px; border-radius: 999px;
    font-size: 12.5px; font-weight: 600;
    background: var(--primary); color: #fff;
    box-shadow: 0 8px 20px -8px rgba(24,119,242,.7);
    transition: background .15s, transform .15s;
  }
  .read-btn:hover { background: var(--primary-dark); transform: translateY(-1px); }
  .read-btn.ghost { background: #fff; color: var(--ink); border: 1px solid var(--border); box-shadow: none; }
  .read-btn.ghost:hover { background: #fff; color: var(--primary); border-color: var(--primary); }

  /* ── CTA ── */
  .newsletter {
    background: var(--dark); border-radius: 28px; padding: 56px 40px;
    text-align: center; margin-bottom: 40px; color: #fff; position: relative; overflow: hidden;
  }
  .newsletter::after {
    content: ''; position: absolute; right: -100px; top: -140px; width: 380px; height: 380px;
    background: radial-gradient(circle, rgba(24,119,242,.4), transparent 65%); pointer-events: none;
  }
  .newsletter .tag { color: #8fb8ff !important; }
  .newsletter h2 { position: relative; font-weight: 600; letter-spacing: -.025em; font-size: clamp(24px, 3.2vw, 36px); margin-top: 12px; line-height: 1.2; }
  .newsletter p { position: relative; font-size: 14.5px; color: #9fb2cc; margin: 14px auto 0; max-width: 46ch; line-height: 1.6; }
  .newsletter-cta { position: relative; display: flex; gap: 12px; justify-content: center; margin-top: 26px; flex-wrap: wrap; }
  .nl-btn {
    padding: 11px 20px; border-radius: 999px; font-size: 13.5px; font-weight: 600;
    display: inline-flex; align-items: center; gap: 8px; transition: transform .15s, background .15s;
  }
  .nl-btn:hover { transform: translateY(-1px); }
  .nl-cta { background: var(--primary); color: #fff; box-shadow: 0 8px 20px -8px rgba(24,119,242,.7); }
  .nl-cta:hover { background: var(--primary-dark); }
  .nl-ghost { background: rgba(255,255,255,.08); color: #fff; border: 1px solid rgba(255,255,255,.16); }

  @media (max-width: 960px) { .articles-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 640px) {
    .articles-grid { grid-template-columns: 1fr; }
    .wrap { padding: 0 16px; }
    .page-hero .hero-panel { padding: 48px 22px 96px; border-radius: 22px; }
    .newsletter { padding: 40px 22px; border-radius: 22px; }
  }
</style>

<!-- Hero -->
<section class="page-hero">
  <div class="wrap">
    <div class="hero-panel">
      <Breadcrumb items={[{ name: 'Blog', href: '/blog/' }]} align="center" />
      <span class="tag">Writing</span>
      <h1>Blog on <span>SEO, GEO &amp; AEO</span></h1>
      <p>Field notes on how search is shifting from rankings to AI citations - and what to actually do about it.</p>
    </div>
  </div>
</section>
<div class="clouds"></div>

<!-- Main content -->
<div class="wrap">
  <!-- Category filters -->
  <div class="filters">
    <button class="filter-btn active" data-filter="all">All</button>
    {categories.map(cat => (
      <button class="filter-btn" data-filter={cat}>{cat}</button>
    ))}
  </div>

  <!-- Blog post grid -->
  <div class="articles-grid" id="articles-grid">
    {articles.map(article => (
      <article class="art-card" data-category={article.data.category}>
        <div class="art-thumb">
          <img src={article.data.image} alt={article.data.title} width={getImageDims(article.data.image).width} height={getImageDims(article.data.image).height} loading="lazy" />
          <span class="art-cat-badge">{article.data.category}</span>
        </div>
        <div class="art-body">
          <div class="art-meta">
            <span>{new Date(article.data.date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' })}</span>
            <span class="art-meta-dot"></span>
            <span>{article.data.readTime}</span>
          </div>
          <h2>{article.data.title}</h2>
          <p>{article.data.excerpt}</p>
          <div class="art-footer">
            <a href={`/blog/${article.slug}/`} class="read-btn">Read post →</a>
            {article.data.linkedinUrl && (
              <a href={article.data.linkedinUrl} target="_blank" rel="noopener" class="read-btn ghost">LinkedIn ↗</a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Newsletter / connect CTA -->
  <div class="newsletter">
    <span class="tag" style="color:#8fb8ff">Stay current</span>
    <h2>Get insights on AI search, GEO &amp; AEO</h2>
    <p>Follow on LinkedIn for new posts on how search is shifting - and what practitioners should do about it.</p>
    <div class="newsletter-cta">
      <a href="https://www.linkedin.com/in/sivaraj-seo-analyst/" target="_blank" rel="noopener" class="nl-btn nl-cta">Follow on LinkedIn →</a>
      <a href="/contact/" class="nl-btn nl-ghost">Get in touch</a>
    </div>
  </div>
</div>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.art-card');

  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const filter = btn.dataset.filter;
      cards.forEach(card => {
        card.style.display = (filter === 'all' || card.dataset.category === filter) ? '' : 'none';
      });
    });
  });
</script>

</BaseLayout>
