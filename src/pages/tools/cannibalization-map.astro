---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { safeJsonLd } from '../../utils/schema';

const title = 'Cannibalization Map — Find Keyword Cannibalization in Search Console';
const description = 'Group a Search Console export by query and surface every case where more than one page is competing for the same search — split clicks, split authority, and Google picking a winner you didn’t choose.';
const keywords = 'keyword cannibalization, GSC query overlap, Search Console pages competing, SEO tool';

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Cannibalization Map',
  applicationCategory: 'SEO Tool',
  operatingSystem: 'Any (browser-based)',
  description,
  url: 'https://www.seowithsiva.com/tools/cannibalization-map/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  creator: { '@id': 'https://www.seowithsiva.com/#person' },
};
---

<BaseLayout {title} {description} {keywords} author="C. Sivaraj">
<Fragment slot="head">
  <script type="application/ld+json" set:html={safeJsonLd(toolSchema)} />
</Fragment>

<main class="tool-page">
  <div class="tool-wrap">
    <div class="tool-eyebrow">GSC Toolkit · Keyword Overlap</div>
    <h1 class="tool-h1">Cannibalization Map</h1>
    <p class="tool-dek">Group a Search Console export by query and surface every case where <b>more than one page</b> is competing for the same search — split clicks, split authority, and Google picking a winner you didn't choose.</p>

    <div class="console">
      <section class="panel input-panel">
        <div class="panel-head"><h2>01 · Data</h2></div>
        <div class="input-body">
          <div class="field">
            <label for="csvFile">GSC export with Query + Page</label>
            <input type="file" id="csvFile" accept=".csv,text/csv" />
            <textarea id="csvText" spellcheck="false" placeholder="Query,Page,Clicks,Impressions,CTR,Position"></textarea>
            <div class="char-count" id="charCount">0 rows detected</div>
          </div>

          <div class="callout" id="reqCallout">Needs a <b>Query</b> AND a <b>Page</b> column on the same row. The Search Console UI's plain export doesn't combine both — pull this from the Search Console API, a Looker Studio table with Query+Page dimensions, or a rank tool's GSC integration.</div>

          <div class="field-pair">
            <div class="field">
              <label for="minPages">Min. pages per query</label>
              <input type="number" id="minPages" value="2" min="2" max="10" step="1" />
            </div>
            <div class="field">
              <label for="minImpr">Min. cluster impressions</label>
              <input type="number" id="minImpr" value="50" min="0" step="10" />
            </div>
          </div>

          <button class="btn-run" id="runBtn">Find cannibalization →</button>
        </div>
      </section>

      <section class="panel results-panel">
        <div class="panel-head">
          <h2>02 · Clusters</h2>
          <span class="note" id="scopeNote"></span>
        </div>
        <div class="results-body" id="resultsBody"></div>
      </section>
    </div>
  </div>
</main>
</BaseLayout>

<style>
  .tool-page { background: #faf9fd; padding: 56px 24px 100px; }
  .tool-wrap { max-width: 1200px; margin: 0 auto; }

  .tool-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .tool-eyebrow::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .tool-h1 { font-size: clamp(28px, 4vw, 42px); font-weight: 800; letter-spacing: -.02em; color: var(--ink); margin: 0 0 14px; line-height: 1.15; }
  .tool-dek { max-width: 64ch; color: var(--muted); font-size: 16px; line-height: 1.65; margin: 0; }
  .tool-dek b { color: var(--ink); font-weight: 700; }

  .console { display: grid; grid-template-columns: minmax(300px, 380px) 1fr; gap: 20px; align-items: start; margin-top: 36px; }
  @media (max-width: 900px) { .console { grid-template-columns: 1fr; } }

  .panel { background: #fff; border: 1.5px solid #e4ddf7; border-radius: 16px; box-shadow: 0 2px 16px rgba(124, 92, 214, .06); }
  .panel-head { padding: 16px 20px; border-bottom: 1px solid #efeafc; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .panel-head h2 { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0; }
  .panel-head .note { font-size: 11px; color: #b0a9c8; }

  .input-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 13px; font-weight: 700; color: var(--ink); }
  .field .hint { font-weight: 400; color: #a49cc2; font-size: 12px; }
  .field-pair { display: flex; gap: 10px; }
  .field-pair .field { flex: 1; }

  .callout { background: #faf9fd; border: 1px solid #efeafc; border-radius: 10px; padding: 10px 12px; font-size: 12px; color: var(--muted); }
  .callout b { color: var(--ink); }

  input[type="text"], input[type="number"], textarea, select {
    width: 100%; background: #faf9fd; border: 1.5px solid #e4ddf7; border-radius: 10px; color: var(--ink);
    padding: 10px 12px; font-family: inherit; font-size: 13px;
  }
  textarea { resize: vertical; min-height: 170px; font-variant-numeric: tabular-nums; }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(124, 92, 214, .15); }
  input::placeholder, textarea::placeholder { color: #c3bcdb; }
  input[type="file"] { font-size: 12.5px; color: var(--muted); }
  .char-count { font-size: 11px; color: #a49cc2; text-align: right; }

  .btn-run { background: var(--accent); color: #fff; border: none; border-radius: 10px; padding: 13px 18px; font-weight: 700; font-size: 14px; font-family: inherit; cursor: pointer; box-shadow: 0 4px 16px rgba(124, 92, 214, .25); transition: transform .12s, box-shadow .12s; }
  .btn-run:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(124, 92, 214, .32); }
  .btn-run:active { transform: translateY(0); }
  .btn-run:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .btn-ghost { background: #f0ebfa; color: var(--accent); border: none; border-radius: 9px; padding: 8px 14px; font-weight: 600; font-size: 12.5px; font-family: inherit; cursor: pointer; }
  .btn-ghost:hover { background: var(--accent); color: #fff; }

  .results-body { padding: 22px; }

  .stat-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 22px; }
  .stat-tile { flex: 1; min-width: 148px; background: #faf9fd; border: 1px solid #efeafc; border-radius: 12px; padding: 14px 16px; }
  .stat-label { font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #b0a9c8; margin-bottom: 6px; }
  .stat-value { font-size: 24px; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stat-value.warn { color: #c2571e; }
  .stat-sub { font-size: 11.5px; color: var(--muted); margin-top: 2px; }

  .section-label { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }

  .toolbar { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; flex-wrap: wrap; }
  .toolbar select { width: auto; }
  .toolbar .toolbar-label { font-size: 12px; color: var(--muted); }

  .cluster-list { display: flex; flex-direction: column; gap: 10px; }
  .cluster-card { border: 1px solid #efeafc; border-radius: 12px; overflow: hidden; background: #fff; }
  .cluster-head { display: flex; align-items: center; gap: 14px; padding: 13px 16px; cursor: pointer; flex-wrap: wrap; }
  .cluster-head:hover { background: #faf9fd; }
  .cluster-query { font-weight: 700; font-size: 14px; flex: 1 1 220px; min-width: 180px; color: var(--ink); }
  .pill { display: inline-flex; align-items: center; gap: 4px; font-size: 10.5px; font-weight: 600; padding: 3px 9px; border-radius: 100px; background: #f0ebfa; color: var(--accent); flex-shrink: 0; }
  .pill.conflict { background: #fdecee; color: #d6425a; }
  .cluster-metrics { display: flex; gap: 16px; font-size: 12px; color: var(--muted); flex-shrink: 0; font-variant-numeric: tabular-nums; }
  .cluster-metrics b { color: var(--ink); }
  .chev { flex-shrink: 0; color: #b0a9c8; font-size: 12px; transition: transform .15s ease; width: 14px; text-align: center; }
  .cluster-card.open .chev { transform: rotate(180deg); }
  .cluster-body { border-top: 1px solid #efeafc; }
  .cluster-body table { width: 100%; border-collapse: collapse; font-size: 12.5px; }
  .cluster-body th { text-align: left; font-size: 10px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #b0a9c8; background: #faf9fd; padding: 7px 16px; }
  .cluster-body th.num, .cluster-body td.num { text-align: right; font-variant-numeric: tabular-nums; }
  .cluster-body td { padding: 7px 16px; border-top: 1px solid #f3f0fa; color: var(--ink); }
  .cluster-body td.page-cell { max-width: 320px; overflow: hidden; text-overflow: ellipsis; }
  .tag { font-size: 10px; font-weight: 600; padding: 1px 7px; border-radius: 100px; margin-left: 6px; }
  .tag.lead { background: #e5f6ec; color: #1a9f4f; }
  .tag.top { background: #f0ebfa; color: var(--accent); }

  .actions { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
  .empty-note { font-size: 13.5px; color: var(--muted); padding: 30px 4px; text-align: center; }
</style>

<script>
  (function () {
    "use strict";

    var EXAMPLE_CSV = [
      "Query,Page,Clicks,Impressions,CTR,Position",
      "compost bin,/products/compost-bin-xl,140,2200,6.4%,4.2",
      "compost bin,/blog/best-compost-bins,90,1400,6.4%,5.8",
      "how to compost,/guides/how-to-compost,220,6000,3.7%,6.1",
      "how to compost,/blog/composting-basics,80,2400,3.3%,9.4",
      "best compost bin,/blog/best-compost-bins,60,700,8.6%,3.5",
      "best compost bin,/products/compost-bin-xl,160,2200,7.3%,6.8",
      "greenbin co,/,410,520,78.8%,1.1",
      "worm compost bin,/products/worm-bin,65,1800,3.6%,8.8",
      "compost bin near me,/locations,70,1100,6.4%,4.6",
      "kitchen compost bin,/products/kitchen-caddy,150,2600,5.8%,6.2",
      "outdoor compost bin,/products/compost-bin-xl,130,2000,6.5%,5.9",
      "compost bin size guide,/guides/compost-bin-sizing,25,500,5.0%,12.1",
      "is composting worth it,/blog/composting-basics,90,3200,2.8%,14.5",
      "compost bin smell solutions,/guides/compost-smell,30,700,4.3%,10.2"
    ].join("\n");

    function parseCSV(text) {
      var rows = [], row = [], field = "", inQuotes = false;
      for (var i = 0; i < text.length; i++) {
        var c = text[i];
        if (inQuotes) {
          if (c === '"') { if (text[i + 1] === '"') { field += '"'; i++; } else { inQuotes = false; } }
          else field += c;
        } else {
          if (c === '"') inQuotes = true;
          else if (c === ",") { row.push(field); field = ""; }
          else if (c === "\r") { /* skip */ }
          else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
          else field += c;
        }
      }
      if (field.length || row.length) { row.push(field); rows.push(row); }
      return rows.filter(function (r) { return r.length > 1 || (r.length === 1 && r[0].trim() !== ""); });
    }

    var HEADER_ALIASES = {
      query: ["query", "queries", "top queries", "search query", "search term", "keyword"],
      page: ["page", "pages", "top pages", "landing page", "url"],
      clicks: ["clicks"],
      impressions: ["impressions", "impr."],
      ctr: ["ctr", "click through rate", "click-through rate"],
      position: ["position", "avg position", "average position", "avg. position"]
    };

    function detectColumns(headerRow) {
      var map = {};
      headerRow.forEach(function (h, i) {
        var norm = h.trim().toLowerCase();
        Object.keys(HEADER_ALIASES).forEach(function (canon) {
          if (map[canon] === undefined && HEADER_ALIASES[canon].indexOf(norm) !== -1) map[canon] = i;
        });
      });
      return map;
    }

    function parseNum(s) {
      if (s === undefined || s === null) return NaN;
      var t = String(s).trim().replace(/,/g, "");
      if (t === "") return NaN;
      return parseFloat(t);
    }
    function parseCTR(s) {
      var t = String(s).trim();
      if (t === "") return NaN;
      var hasPct = /%/.test(t);
      var n = parseFloat(t.replace("%", ""));
      if (isNaN(n)) return NaN;
      return hasPct ? n : (n <= 1 ? n * 100 : n);
    }

    function buildDataset(csvText) {
      var raw = parseCSV(csvText.trim());
      if (!raw.length) return null;
      var cols = detectColumns(raw[0]);
      var body = raw.slice(1);
      var rows = body.map(function (r) {
        var row = {
          query: cols.query !== undefined ? (r[cols.query] || "").trim() : "",
          page: cols.page !== undefined ? (r[cols.page] || "").trim() : "",
          clicks: cols.clicks !== undefined ? parseNum(r[cols.clicks]) : NaN,
          impressions: cols.impressions !== undefined ? parseNum(r[cols.impressions]) : NaN,
          ctr: cols.ctr !== undefined ? parseCTR(r[cols.ctr]) : NaN,
          position: cols.position !== undefined ? parseNum(r[cols.position]) : NaN
        };
        if (isNaN(row.clicks)) row.clicks = 0;
        if (isNaN(row.impressions)) row.impressions = 0;
        if (isNaN(row.ctr) && row.impressions > 0) row.ctr = (row.clicks / row.impressions) * 100;
        return row;
      }).filter(function (r) { return r.query || r.page; });
      return {
        rows: rows,
        hasQuery: cols.query !== undefined,
        hasPage: cols.page !== undefined,
        hasPosition: cols.position !== undefined
      };
    }

    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
    function fmtInt(n) { return Math.round(n).toLocaleString(); }
    function fmtPct(n) { return (isFinite(n) ? n.toFixed(1) : "0.0") + "%"; }
    function fmtPos(n) { return n === null || n === undefined || isNaN(n) ? "—" : n.toFixed(1); }

    var els = {
      csvFile: document.getElementById("csvFile"),
      csvText: document.getElementById("csvText"),
      charCount: document.getElementById("charCount"),
      minPages: document.getElementById("minPages"),
      minImpr: document.getElementById("minImpr"),
      runBtn: document.getElementById("runBtn"),
      resultsBody: document.getElementById("resultsBody"),
      scopeNote: document.getElementById("scopeNote")
    };

    els.csvFile.addEventListener("change", function () {
      var file = els.csvFile.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (e) {
        els.csvText.value = String(e.target.result);
        updateCharCount();
        runFromFields();
      };
      reader.readAsText(file);
    });

    function updateCharCount() {
      var lines = els.csvText.value.split("\n").filter(function (l) { return l.trim(); }).length;
      els.charCount.textContent = Math.max(0, lines - 1).toLocaleString() + " rows detected";
    }
    els.csvText.addEventListener("input", updateCharCount);

    var lastDataset = null, lastClusters = [], sortBy = "impressions", openSet = {};

    function buildClusters(rows, minPages, minImpr) {
      var byQuery = {};
      rows.forEach(function (r) {
        var key = r.query.trim().toLowerCase();
        if (!byQuery[key]) byQuery[key] = { query: r.query, pages: {} };
        var g = byQuery[key];
        var pk = r.page;
        if (!g.pages[pk]) g.pages[pk] = { page: pk, clicks: 0, impressions: 0, posWeighted: 0, posCount: 0 };
        var p = g.pages[pk];
        p.clicks += r.clicks;
        p.impressions += r.impressions;
        if (!isNaN(r.position) && r.impressions) { p.posWeighted += r.position * r.impressions; p.posCount += r.impressions; }
      });

      var clusters = [];
      Object.keys(byQuery).forEach(function (key) {
        var g = byQuery[key];
        var pages = Object.keys(g.pages).map(function (pk) {
          var p = g.pages[pk];
          return {
            page: p.page,
            clicks: p.clicks,
            impressions: p.impressions,
            ctr: p.impressions ? (p.clicks / p.impressions * 100) : 0,
            position: p.posCount ? (p.posWeighted / p.posCount) : null
          };
        });
        if (pages.length < minPages) return;
        var totalClicks = pages.reduce(function (a, p) { return a + p.clicks; }, 0);
        var totalImpressions = pages.reduce(function (a, p) { return a + p.impressions; }, 0);
        if (totalImpressions < minImpr) return;
        pages.sort(function (a, b) { return b.clicks - a.clicks; });
        var primary = pages[0];
        var withPos = pages.filter(function (p) { return p.position !== null; });
        var leading = withPos.length ? withPos.slice().sort(function (a, b) { return a.position - b.position; })[0] : null;
        var conflict = !!(leading && leading.page !== primary.page);
        clusters.push({
          query: g.query,
          pages: pages,
          pageCount: pages.length,
          totalClicks: totalClicks,
          totalImpressions: totalImpressions,
          ctr: totalImpressions ? (totalClicks / totalImpressions * 100) : 0,
          primary: primary,
          leading: leading,
          conflict: conflict
        });
      });
      return clusters;
    }

    function runFromFields() {
      var ds = buildDataset(els.csvText.value);
      updateCharCount();
      if (!ds || !ds.rows.length) {
        els.resultsBody.innerHTML = '<div class="empty-note">No rows with both a Query and a Page detected. Paste an export with both columns, or upload a CSV file.</div>';
        return;
      }
      if (!ds.hasQuery || !ds.hasPage) {
        els.resultsBody.innerHTML = '<div class="empty-note">This export is missing a Query or a Page column — cannibalization needs both on the same row. See the note above for how to get a combined export.</div>';
        return;
      }
      lastDataset = ds;
      openSet = {};
      render();
    }

    function render() {
      var ds = lastDataset;
      var minPages = Math.max(2, parseInt(els.minPages.value, 10) || 2);
      var minImpr = parseFloat(els.minImpr.value) || 0;
      var clusters = buildClusters(ds.rows, minPages, minImpr);

      var sorters = {
        impressions: function (a, b) { return b.totalImpressions - a.totalImpressions; },
        clicks: function (a, b) { return b.totalClicks - a.totalClicks; },
        pages: function (a, b) { return b.pageCount - a.pageCount; }
      };
      clusters.sort(sorters[sortBy] || sorters.impressions);
      lastClusters = clusters;

      var distinctQueries = {};
      ds.rows.forEach(function (r) { distinctQueries[r.query.trim().toLowerCase()] = true; });
      var conflictCount = clusters.filter(function (c) { return c.conflict; }).length;
      var impressionsAtStake = clusters.reduce(function (a, c) { return a + c.totalImpressions; }, 0);

      els.scopeNote.textContent = Object.keys(distinctQueries).length.toLocaleString() + " distinct queries · " + clusters.length + " overlapping";

      var html = "";
      html += '<div class="stat-row">' +
        statTile("Distinct queries", fmtInt(Object.keys(distinctQueries).length), "") +
        statTile("Cannibalized queries", fmtInt(clusters.length), "≥" + minPages + " pages, ≥" + fmtInt(minImpr) + " impr") +
        statTile("Conflicting signals", fmtInt(conflictCount), "best-ranked page isn't the top clicker", conflictCount > 0) +
        statTile("Impressions at stake", fmtInt(impressionsAtStake), "across overlapping queries") +
        "</div>";

      if (!clusters.length) {
        html += '<div class="empty-note">No overlapping queries at this threshold. Lower "min. pages per query" or "min. cluster impressions".</div>';
        els.resultsBody.innerHTML = html;
        return;
      }

      html += '<div class="toolbar">' +
        '<span class="toolbar-label">Sort by</span>' +
        '<select id="sortSelect">' +
        '<option value="impressions"' + (sortBy === "impressions" ? " selected" : "") + '>Total impressions</option>' +
        '<option value="clicks"' + (sortBy === "clicks" ? " selected" : "") + '>Total clicks</option>' +
        '<option value="pages"' + (sortBy === "pages" ? " selected" : "") + '>Number of pages</option>' +
        "</select>" +
        "</div>";

      html += '<div class="cluster-list">' + clusters.map(function (c, i) { return clusterCard(c, i, ds.hasPosition); }).join("") + "</div>";
      html += '<div class="actions"><button class="btn-ghost" id="downloadBtn" type="button">Download clusters CSV</button></div>';

      els.resultsBody.innerHTML = html;

      var sortSelect = document.getElementById("sortSelect");
      if (sortSelect) sortSelect.addEventListener("change", function () { sortBy = sortSelect.value; render(); });

      els.resultsBody.querySelectorAll(".cluster-head").forEach(function (head) {
        head.addEventListener("click", function () {
          var idx = head.dataset.idx;
          openSet[idx] = !openSet[idx];
          var card = head.closest(".cluster-card");
          var body = card.querySelector(".cluster-body");
          card.classList.toggle("open", !!openSet[idx]);
          body.hidden = !openSet[idx];
        });
      });
      var dl = document.getElementById("downloadBtn");
      if (dl) dl.addEventListener("click", downloadCSV);
    }

    function clusterCard(c, idx, hasPosition) {
      var isOpen = !!openSet[idx];
      var rowsHtml = c.pages.map(function (p) {
        var tags = "";
        if (p.page === c.primary.page) tags += '<span class="tag top">most clicks</span>';
        if (c.leading && p.page === c.leading.page) tags += '<span class="tag lead">best position</span>';
        return "<tr>" +
          '<td class="page-cell">' + esc(p.page) + tags + "</td>" +
          '<td class="num">' + fmtInt(p.clicks) + "</td>" +
          '<td class="num">' + fmtInt(p.impressions) + "</td>" +
          '<td class="num">' + fmtPct(p.ctr) + "</td>" +
          (hasPosition ? '<td class="num">' + fmtPos(p.position) + "</td>" : "") +
          "</tr>";
      }).join("");
      return '<div class="cluster-card' + (isOpen ? " open" : "") + '">' +
        '<div class="cluster-head" data-idx="' + idx + '">' +
        '<span class="cluster-query">"' + esc(c.query) + '"</span>' +
        '<span class="pill">' + c.pageCount + " pages</span>" +
        (c.conflict ? '<span class="pill conflict">⚠ conflicting signals</span>' : "") +
        '<span class="cluster-metrics"><span>Impr <b>' + fmtInt(c.totalImpressions) + "</b></span><span>Clicks <b>" + fmtInt(c.totalClicks) + "</b></span><span>CTR <b>" + fmtPct(c.ctr) + "</b></span></span>" +
        '<span class="chev">▾</span>' +
        "</div>" +
        '<div class="cluster-body" ' + (isOpen ? "" : "hidden") + '><table><thead><tr><th>Page</th><th class="num">Clicks</th><th class="num">Impressions</th><th class="num">CTR</th>' + (hasPosition ? '<th class="num">Position</th>' : "") + "</tr></thead><tbody>" + rowsHtml + "</tbody></table></div>" +
        "</div>";
    }

    function statTile(label, value, sub, warn) {
      return '<div class="stat-tile"><div class="stat-label">' + esc(label) + '</div><div class="stat-value' + (warn ? " warn" : "") + '">' + value + "</div>" + (sub ? '<div class="stat-sub">' + esc(sub) + "</div>" : "") + "</div>";
    }

    function csvCell(v) {
      var s = v === null || v === undefined ? "" : String(v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    }
    function csvRow(cells) { return cells.map(csvCell).join(","); }

    function triggerDownload(filename, text) {
      var blob = new Blob([text], { type: "text/csv;charset=utf-8" });
      var url = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function downloadCSV() {
      if (!lastClusters.length) return;
      var header = ["Query", "Page", "Clicks", "Impressions", "CTR%", "Position", "Most clicks", "Best position", "Conflicting signals"];
      var rows = [header];
      lastClusters.forEach(function (c) {
        c.pages.forEach(function (p) {
          rows.push([
            c.query, p.page, p.clicks, p.impressions, p.ctr.toFixed(2),
            p.position === null ? "" : p.position.toFixed(1),
            p.page === c.primary.page ? "yes" : "",
            c.leading && p.page === c.leading.page ? "yes" : "",
            c.conflict ? "yes" : ""
          ]);
        });
      });
      triggerDownload("cannibalization-clusters.csv", rows.map(csvRow).join("\r\n"));
    }

    els.runBtn.addEventListener("click", runFromFields);

    els.csvText.value = EXAMPLE_CSV;
    runFromFields();
  })();
</script>
