---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { safeJsonLd } from '../../utils/schema';

const title = 'Regex Segments — Search Console Query Segmentation Tool';
const description = 'Paste a Search Console query export and split it into segments with regex — brand vs. non-brand, informational vs. transactional — with clicks, impressions, CTR and position rolled up per segment.';
const keywords = 'regex segments, GSC query segmentation, Search Console regex, branded vs non-branded queries, SEO tool';

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Regex Segments',
  applicationCategory: 'SEO Tool',
  operatingSystem: 'Any (browser-based)',
  description,
  url: 'https://www.seowithsiva.com/tools/regex-segments/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  creator: { '@id': 'https://www.seowithsiva.com/#person' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.seowithsiva.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.seowithsiva.com/tools/' },
    { '@type': 'ListItem', position: 3, name: 'Regex Segments', item: 'https://www.seowithsiva.com/tools/regex-segments/' },
  ],
};
---

<BaseLayout {title} {description} {keywords} author="C. Sivaraj">
<Fragment slot="head">
  <script type="application/ld+json" set:html={safeJsonLd(toolSchema)} />
  <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />
</Fragment>

<main class="tool-page">
  <div class="tool-wrap">
    <div class="tool-eyebrow">GSC Toolkit · Query Segmentation</div>
    <h1 class="tool-h1">Regex Segments</h1>
    <p class="tool-dek">Paste a Search Console query export, define a few regex patterns, and roll up <b>clicks, impressions, CTR and position</b> per segment — brand vs. non-brand, informational vs. transactional, or whatever cuts matter for your site.</p>

    <div class="console">
      <section class="panel input-panel">
        <div class="panel-head"><h2>01 · Data</h2></div>
        <div class="input-body">
          <div class="field">
            <label for="csvFile">GSC query export</label>
            <span class="hint">Search Console → Performance → Export → CSV. Needs a Query column plus Clicks/Impressions/CTR/Position.</span>
            <input type="file" id="csvFile" accept=".csv,text/csv" />
            <textarea id="csvText" spellcheck="false" placeholder="Query,Clicks,Impressions,CTR,Position"></textarea>
            <div class="char-count" id="charCount">0 rows detected</div>
          </div>

          <div class="field">
            <label>Match against <span class="hint">— which column the patterns test</span></label>
            <select id="matchField"></select>
          </div>

          <div class="field">
            <label>Segments <span class="hint">— tested in order, first match wins; anything left over is "Unmatched"</span></label>
            <div class="seg-list" id="segList"></div>
            <button class="btn-ghost seg-add" id="addSeg" type="button">+ Add segment</button>
          </div>

          <div class="toggle-row">
            <input type="checkbox" id="caseInsensitive" checked />
            <label for="caseInsensitive">Case-insensitive matching</label>
          </div>

          <button class="btn-run" id="runBtn">Run segmentation →</button>
        </div>
      </section>

      <section class="panel results-panel">
        <div class="panel-head">
          <h2>02 · Segments</h2>
          <span class="note" id="scopeNote"></span>
        </div>
        <div class="results-body" id="resultsBody"></div>
      </section>
    </div>
  </div>
</main>
</BaseLayout>

<style>
  .tool-page { background: #faf9fd; padding: 56px 24px 100px; }
  .tool-wrap { max-width: 1200px; margin: 0 auto; }

  .tool-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .tool-eyebrow::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .tool-h1 { font-size: clamp(28px, 4vw, 42px); font-weight: 800; letter-spacing: -.02em; color: var(--ink); margin: 0 0 14px; line-height: 1.15; }
  .tool-dek { max-width: 64ch; color: var(--muted); font-size: 16px; line-height: 1.65; margin: 0; }
  .tool-dek b { color: var(--ink); font-weight: 700; }

  .console { display: grid; grid-template-columns: minmax(300px, 380px) 1fr; gap: 20px; align-items: start; margin-top: 36px; }
  @media (max-width: 900px) { .console { grid-template-columns: 1fr; } }

  .panel { background: #fff; border: 1.5px solid #e4ddf7; border-radius: 16px; box-shadow: 0 2px 16px rgba(124, 92, 214, .06); }
  .panel-head { padding: 16px 20px; border-bottom: 1px solid #efeafc; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .panel-head h2 { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0; }
  .panel-head .note { font-size: 11px; color: #b0a9c8; }

  .input-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 13px; font-weight: 700; color: var(--ink); }
  .field .hint { font-weight: 400; color: #a49cc2; font-size: 12px; }

  input[type="text"], input[type="number"], textarea, select {
    width: 100%; background: #faf9fd; border: 1.5px solid #e4ddf7; border-radius: 10px; color: var(--ink);
    padding: 10px 12px; font-family: inherit; font-size: 13px;
  }
  textarea { resize: vertical; min-height: 170px; font-variant-numeric: tabular-nums; }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(124, 92, 214, .15); }
  input::placeholder, textarea::placeholder { color: #c3bcdb; }
  input[type="file"] { font-size: 12.5px; color: var(--muted); }
  .char-count { font-size: 11px; color: #a49cc2; text-align: right; }

  .btn-run { background: var(--accent); color: #fff; border: none; border-radius: 10px; padding: 13px 18px; font-weight: 700; font-size: 14px; font-family: inherit; cursor: pointer; box-shadow: 0 4px 16px rgba(124, 92, 214, .25); transition: transform .12s, box-shadow .12s; }
  .btn-run:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(124, 92, 214, .32); }
  .btn-run:active { transform: translateY(0); }
  .btn-run:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .btn-ghost { background: #f0ebfa; color: var(--accent); border: none; border-radius: 9px; padding: 8px 14px; font-weight: 600; font-size: 12.5px; font-family: inherit; cursor: pointer; }
  .btn-ghost:hover { background: var(--accent); color: #fff; }
  .btn-ghost:disabled { opacity: .5; cursor: default; }

  .toggle-row { display: flex; align-items: center; gap: 8px; font-size: 12.5px; color: var(--muted); }
  .toggle-row input { width: auto; accent-color: var(--accent); }

  .seg-list { display: flex; flex-direction: column; gap: 6px; }
  .seg-row { display: flex; gap: 8px; align-items: center; }
  .seg-row .seg-label { flex: 0 0 110px; }
  .seg-row .seg-pattern { flex: 1; }
  .seg-row .seg-swatch { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; }
  .seg-del { background: #f5f3fa; border: none; color: #a49cc2; border-radius: 8px; width: 32px; height: 34px; cursor: pointer; flex-shrink: 0; font-size: 14px; line-height: 1; }
  .seg-del:hover { color: #d6425a; background: #fdecee; }
  .seg-error { font-size: 11px; color: #d6425a; margin: 2px 0 4px 118px; }
  .seg-add { align-self: flex-start; margin-top: 2px; }

  .results-body { padding: 22px; }

  .stat-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 22px; }
  .stat-tile { flex: 1; min-width: 148px; background: #faf9fd; border: 1px solid #efeafc; border-radius: 12px; padding: 14px 16px; }
  .stat-label { font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #b0a9c8; margin-bottom: 6px; }
  .stat-value { font-size: 24px; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stat-sub { font-size: 11.5px; color: var(--muted); margin-top: 2px; }

  .section-label { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }

  .share-block { margin-bottom: 26px; }
  .share-row { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; cursor: pointer; border-radius: 8px; padding: 4px 6px; }
  .share-row:hover { background: #faf9fd; }
  .share-row.active { background: #f0ebfa; }
  .share-swatch { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
  .share-label { width: 150px; font-size: 12.5px; flex-shrink: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--ink); }
  .share-track { flex: 1; height: 9px; background: #efeafc; border-radius: 100px; overflow: hidden; min-width: 60px; }
  .share-fill { height: 100%; border-radius: 100px; }
  .share-meta { width: 230px; flex-shrink: 0; text-align: right; font-size: 11.5px; color: var(--muted); font-variant-numeric: tabular-nums; }

  .table-wrap { overflow-x: auto; border: 1px solid #efeafc; border-radius: 12px; }
  table.data { width: 100%; border-collapse: collapse; font-size: 13px; white-space: nowrap; }
  table.data th { text-align: left; font-size: 10.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #b0a9c8; background: #faf9fd; padding: 10px 12px; border-bottom: 1px solid #efeafc; }
  table.data th.num, table.data td.num { text-align: right; font-variant-numeric: tabular-nums; }
  table.data td { padding: 8px 12px; border-bottom: 1px solid #f3f0fa; color: var(--ink); }
  table.data tbody tr:hover td { background: #faf9fd; }
  table.data td.query-cell { white-space: normal; max-width: 340px; }
  .seg-pill { display: inline-block; font-size: 10.5px; font-weight: 600; padding: 2px 8px; border-radius: 100px; }

  .search-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
  .search-row input { max-width: 260px; }

  .actions { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
  .empty-note { font-size: 13.5px; color: var(--muted); padding: 30px 4px; text-align: center; }
</style>

<script>
  (function () {
    "use strict";

    var PALETTE = ["#7c5cd6", "#b5652a", "#1a9f4f", "#2f8fb0", "#c25a97", "#c2571e", "#5a6bc2", "#8b7bd8"];
    var UNMATCHED_COLOR = "#a49cc2";

    var EXAMPLE_CSV = [
      "Query,Clicks,Impressions,CTR,Position",
      "compost bin,210,3400,6.2%,4.8",
      "best compost bin,180,2100,8.6%,3.2",
      "compost bin for apartment,95,1200,7.9%,5.1",
      "how to compost at home,340,9800,3.5%,7.6",
      "what can you compost,120,4100,2.9%,9.3",
      "compost bin reviews,60,900,6.7%,4.4",
      "greenbin co,410,520,78.8%,1.1",
      "greenbin composter,88,140,62.9%,1.3",
      "kitchen compost bin,150,2600,5.8%,6.2",
      "outdoor compost bin,130,2000,6.5%,5.9",
      "compost bin near me,70,1100,6.4%,4.6",
      "tumbling composter vs bin,40,1500,2.7%,11.4",
      "worm compost bin,65,1800,3.6%,8.8",
      "compost bin smell solutions,30,700,4.3%,10.2",
      "small compost bin for apartment,55,600,9.2%,3.8",
      "compost bin size guide,25,500,5.0%,12.1",
      "is composting worth it,90,3200,2.8%,14.5",
      "compost bin vs pile,45,1700,2.6%,13.2"
    ].join("\n");

    var DEFAULT_SEGMENTS = [
      { label: "Brand", pattern: "greenbin" },
      { label: "Local", pattern: "near me|local" },
      { label: "Comparison", pattern: "\\bvs\\b|best|reviews" },
      { label: "Informational", pattern: "^how|^what|^is\\b|guide|solutions" }
    ];

    function parseCSV(text) {
      var rows = [], row = [], field = "", inQuotes = false;
      for (var i = 0; i < text.length; i++) {
        var c = text[i];
        if (inQuotes) {
          if (c === '"') { if (text[i + 1] === '"') { field += '"'; i++; } else { inQuotes = false; } }
          else field += c;
        } else {
          if (c === '"') inQuotes = true;
          else if (c === ",") { row.push(field); field = ""; }
          else if (c === "\r") { /* skip */ }
          else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
          else field += c;
        }
      }
      if (field.length || row.length) { row.push(field); rows.push(row); }
      return rows.filter(function (r) { return r.length > 1 || (r.length === 1 && r[0].trim() !== ""); });
    }

    var HEADER_ALIASES = {
      query: ["query", "queries", "top queries", "search query", "search term", "keyword"],
      page: ["page", "pages", "top pages", "landing page", "url"],
      clicks: ["clicks"],
      impressions: ["impressions", "impr."],
      ctr: ["ctr", "click through rate", "click-through rate"],
      position: ["position", "avg position", "average position", "avg. position"]
    };

    function detectColumns(headerRow) {
      var map = {};
      headerRow.forEach(function (h, i) {
        var norm = h.trim().toLowerCase();
        Object.keys(HEADER_ALIASES).forEach(function (canon) {
          if (map[canon] === undefined && HEADER_ALIASES[canon].indexOf(norm) !== -1) map[canon] = i;
        });
      });
      return map;
    }

    function parseNum(s) {
      if (s === undefined || s === null) return NaN;
      var t = String(s).trim().replace(/,/g, "");
      if (t === "") return NaN;
      return parseFloat(t);
    }
    function parseCTR(s) {
      var t = String(s).trim();
      if (t === "") return NaN;
      var hasPct = /%/.test(t);
      var n = parseFloat(t.replace("%", ""));
      if (isNaN(n)) return NaN;
      return hasPct ? n : (n <= 1 ? n * 100 : n);
    }

    function buildDataset(csvText) {
      var raw = parseCSV(csvText.trim());
      if (!raw.length) return null;
      var cols = detectColumns(raw[0]);
      var body = raw.slice(1);
      var rows = body.map(function (r) {
        var row = {
          query: cols.query !== undefined ? (r[cols.query] || "").trim() : "",
          page: cols.page !== undefined ? (r[cols.page] || "").trim() : "",
          clicks: cols.clicks !== undefined ? parseNum(r[cols.clicks]) : NaN,
          impressions: cols.impressions !== undefined ? parseNum(r[cols.impressions]) : NaN,
          ctr: cols.ctr !== undefined ? parseCTR(r[cols.ctr]) : NaN,
          position: cols.position !== undefined ? parseNum(r[cols.position]) : NaN
        };
        if (isNaN(row.clicks)) row.clicks = 0;
        if (isNaN(row.impressions)) row.impressions = 0;
        if (isNaN(row.ctr) && row.impressions > 0) row.ctr = (row.clicks / row.impressions) * 100;
        return row;
      }).filter(function (r) { return r.query || r.page; });
      return {
        rows: rows,
        hasQuery: cols.query !== undefined,
        hasPage: cols.page !== undefined,
        hasClicks: cols.clicks !== undefined,
        hasImpressions: cols.impressions !== undefined,
        hasCTR: cols.ctr !== undefined,
        hasPosition: cols.position !== undefined
      };
    }

    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
    function fmtInt(n) { return Math.round(n).toLocaleString(); }
    function fmtPct(n) { return (isFinite(n) ? n.toFixed(1) : "0.0") + "%"; }
    function fmtPos(n) { return n === null || n === undefined || isNaN(n) ? "—" : n.toFixed(1); }

    var els = {
      csvFile: document.getElementById("csvFile"),
      csvText: document.getElementById("csvText"),
      charCount: document.getElementById("charCount"),
      matchField: document.getElementById("matchField"),
      segList: document.getElementById("segList"),
      addSeg: document.getElementById("addSeg"),
      caseInsensitive: document.getElementById("caseInsensitive"),
      runBtn: document.getElementById("runBtn"),
      resultsBody: document.getElementById("resultsBody"),
      scopeNote: document.getElementById("scopeNote")
    };

    var segments = DEFAULT_SEGMENTS.map(function (s) { return { label: s.label, pattern: s.pattern }; });

    function renderSegRows() {
      els.segList.innerHTML = "";
      segments.forEach(function (seg, idx) {
        var row = document.createElement("div");
        row.className = "seg-row";
        var color = PALETTE[idx % PALETTE.length];
        row.innerHTML =
          '<span class="seg-swatch" style="background:' + color + '"></span>' +
          '<input type="text" class="seg-label" data-idx="' + idx + '" value="' + esc(seg.label) + '" placeholder="Label" />' +
          '<input type="text" class="seg-pattern" data-idx="' + idx + '" value="' + esc(seg.pattern) + '" placeholder="regex pattern" />' +
          '<button type="button" class="seg-del" data-idx="' + idx + '" title="Remove">×</button>';
        els.segList.appendChild(row);
      });
      els.segList.querySelectorAll(".seg-label").forEach(function (input) {
        input.addEventListener("input", function () { segments[+input.dataset.idx].label = input.value; });
      });
      els.segList.querySelectorAll(".seg-pattern").forEach(function (input) {
        input.addEventListener("input", function () { segments[+input.dataset.idx].pattern = input.value; });
      });
      els.segList.querySelectorAll(".seg-del").forEach(function (btn) {
        btn.addEventListener("click", function () {
          segments.splice(+btn.dataset.idx, 1);
          renderSegRows();
        });
      });
    }
    els.addSeg.addEventListener("click", function () {
      segments.push({ label: "New segment", pattern: "" });
      renderSegRows();
    });
    renderSegRows();

    els.csvFile.addEventListener("change", function () {
      var file = els.csvFile.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (e) {
        els.csvText.value = String(e.target.result);
        updateCharCount();
        runFromFields();
      };
      reader.readAsText(file);
    });

    function updateCharCount() {
      var lines = els.csvText.value.split("\n").filter(function (l) { return l.trim(); }).length;
      els.charCount.textContent = Math.max(0, lines - 1).toLocaleString() + " rows detected";
    }
    els.csvText.addEventListener("input", updateCharCount);

    function populateMatchField(ds) {
      var opts = [];
      if (ds.hasQuery) opts.push({ v: "query", l: "Query" });
      if (ds.hasPage) opts.push({ v: "page", l: "Page" });
      if (!opts.length) opts.push({ v: "query", l: "Query (none detected)" });
      els.matchField.innerHTML = opts.map(function (o) { return '<option value="' + o.v + '">' + o.l + "</option>"; }).join("");
    }

    function segmentRows(rows, matchField, segs, caseInsensitive) {
      var compiled = segs.map(function (s, idx) {
        var color = PALETTE[idx % PALETTE.length];
        if (!s.pattern) return { label: s.label || "(untitled)", re: null, error: "Empty pattern", color: color };
        try {
          return { label: s.label || "(untitled)", re: new RegExp(s.pattern, caseInsensitive ? "i" : ""), error: null, color: color };
        } catch (e) {
          return { label: s.label || "(untitled)", re: null, error: e.message, color: color };
        }
      });
      rows.forEach(function (r) {
        var text = r[matchField] || "";
        var matched = null;
        for (var i = 0; i < compiled.length; i++) {
          var c = compiled[i];
          if (c.re && c.re.test(text)) { matched = c.label; break; }
        }
        r._segment = matched || "Unmatched";
      });
      return compiled;
    }

    function aggregate(rows, compiled) {
      var map = {};
      rows.forEach(function (r) {
        var key = r._segment;
        if (!map[key]) map[key] = { label: key, count: 0, clicks: 0, impressions: 0, posWeighted: 0, posCount: 0 };
        var g = map[key];
        g.count++;
        g.clicks += r.clicks || 0;
        g.impressions += r.impressions || 0;
        if (!isNaN(r.position) && r.impressions) { g.posWeighted += r.position * r.impressions; g.posCount += r.impressions; }
      });
      var order = compiled.map(function (c) { return c.label; });
      var colorFor = {};
      compiled.forEach(function (c) { colorFor[c.label] = c.color; });
      colorFor["Unmatched"] = UNMATCHED_COLOR;
      var list = Object.keys(map).map(function (k) {
        var g = map[k];
        return {
          label: g.label,
          color: colorFor[g.label] || UNMATCHED_COLOR,
          count: g.count,
          clicks: g.clicks,
          impressions: g.impressions,
          ctr: g.impressions ? (g.clicks / g.impressions * 100) : 0,
          position: g.posCount ? (g.posWeighted / g.posCount) : null
        };
      });
      list.sort(function (a, b) {
        var ia = order.indexOf(a.label); if (ia === -1) ia = 999;
        var ib = order.indexOf(b.label); if (ib === -1) ib = 999;
        return ia - ib;
      });
      return list;
    }

    var lastDataset = null, lastMatchField = "query", lastSummary = null, activeFilter = null;

    function runFromFields() {
      var ds = buildDataset(els.csvText.value);
      updateCharCount();
      if (!ds || !ds.rows.length) {
        els.resultsBody.innerHTML = '<div class="empty-note">No rows detected. Paste a Search Console export with a header row, or upload a CSV file.</div>';
        return;
      }
      populateMatchField(ds);
      var matchField = els.matchField.value || (ds.hasQuery ? "query" : "page");
      lastDataset = ds;
      lastMatchField = matchField;
      activeFilter = null;
      render();
    }

    function render() {
      var ds = lastDataset;
      var compiled = segmentRows(ds.rows, lastMatchField, segments, els.caseInsensitive.checked);
      var summary = aggregate(ds.rows, compiled);
      lastSummary = summary;

      els.scopeNote.textContent = ds.rows.length.toLocaleString() + " rows · matching on " + lastMatchField;

      var totalClicks = ds.rows.reduce(function (a, r) { return a + r.clicks; }, 0);
      var totalImpr = ds.rows.reduce(function (a, r) { return a + r.impressions; }, 0);
      var unmatchedCount = summary.filter(function (s) { return s.label === "Unmatched"; }).reduce(function (a, s) { return a + s.count; }, 0);
      var errorSegs = compiled.filter(function (c) { return c.error; });

      var html = "";

      html += '<div class="stat-row">' +
        statTile("Total queries", fmtInt(ds.rows.length), "") +
        statTile("Total clicks", fmtInt(totalClicks), "") +
        statTile("Total impressions", fmtInt(totalImpr), "") +
        statTile("Unmatched", fmtInt(unmatchedCount), unmatchedCount ? ((unmatchedCount / ds.rows.length * 100).toFixed(0) + "% of rows") : "everything classified") +
        "</div>";

      if (errorSegs.length) {
        html += '<div class="seg-error" style="margin-left:0">Invalid pattern in: ' + errorSegs.map(function (c) { return esc(c.label) + " (" + esc(c.error) + ")"; }).join(", ") + ' — those rows fall to Unmatched.</div>';
      }

      html += '<div class="share-block"><div class="section-label">Share of clicks by segment</div>';
      summary.forEach(function (s) {
        var pct = totalClicks ? (s.clicks / totalClicks * 100) : 0;
        html += '<div class="share-row' + (activeFilter === s.label ? " active" : "") + '" data-seg="' + esc(s.label) + '">' +
          '<span class="share-swatch" style="background:' + s.color + '"></span>' +
          '<span class="share-label">' + esc(s.label) + '</span>' +
          '<span class="share-track"><span class="share-fill" style="width:' + pct.toFixed(1) + '%;background:' + s.color + '"></span></span>' +
          '<span class="share-meta">' + fmtInt(s.clicks) + ' clicks · ' + fmtPct(s.ctr) + ' CTR · pos ' + fmtPos(s.position) + '</span>' +
          "</div>";
      });
      html += "</div>";

      var filtered = activeFilter ? ds.rows.filter(function (r) { return r._segment === activeFilter; }) : ds.rows;

      html += '<div class="section-label">' + (activeFilter ? "Rows in “" + esc(activeFilter) + "” (" + filtered.length + ")" : "All rows (" + filtered.length + ")") + "</div>";
      html += '<div class="search-row">' +
        '<input type="text" id="rowSearch" placeholder="Filter rows…" />' +
        (activeFilter ? '<button class="btn-ghost" id="clearFilter" type="button">Clear segment filter</button>' : "") +
        "</div>";
      html += '<div class="table-wrap"><table class="data"><thead><tr>' +
        "<th>" + (ds.hasQuery ? "Query" : "Page") + "</th><th>Segment</th>" +
        '<th class="num">Clicks</th><th class="num">Impressions</th><th class="num">CTR</th><th class="num">Position</th>' +
        '</tr></thead><tbody id="rowBody"></tbody></table></div>';

      html += '<div class="actions"><button class="btn-ghost" id="downloadBtn" type="button">Download annotated CSV</button></div>';

      els.resultsBody.innerHTML = html;

      renderRowBody(filtered, "");

      els.resultsBody.querySelectorAll(".share-row").forEach(function (row) {
        row.addEventListener("click", function () {
          var seg = row.dataset.seg;
          activeFilter = activeFilter === seg ? null : seg;
          render();
        });
      });
      var searchInput = document.getElementById("rowSearch");
      if (searchInput) searchInput.addEventListener("input", function () { renderRowBody(filtered, searchInput.value); });
      var clearBtn = document.getElementById("clearFilter");
      if (clearBtn) clearBtn.addEventListener("click", function () { activeFilter = null; render(); });
      var dl = document.getElementById("downloadBtn");
      if (dl) dl.addEventListener("click", downloadCSV);
    }

    function renderRowBody(rows, query) {
      var body = document.getElementById("rowBody");
      if (!body) return;
      var q = query.trim().toLowerCase();
      var shown = q ? rows.filter(function (r) { return (r.query + " " + r.page).toLowerCase().indexOf(q) !== -1; }) : rows;
      var colorFor = {};
      lastSummary.forEach(function (s) { colorFor[s.label] = s.color; });
      var max = 400;
      body.innerHTML = shown.slice(0, max).map(function (r) {
        var color = colorFor[r._segment] || UNMATCHED_COLOR;
        return "<tr>" +
          '<td class="query-cell">' + esc(r.query || r.page) + "</td>" +
          '<td><span class="seg-pill" style="background:color-mix(in srgb, ' + color + ' 18%, transparent);color:' + color + '">' + esc(r._segment) + "</span></td>" +
          '<td class="num">' + fmtInt(r.clicks) + "</td>" +
          '<td class="num">' + fmtInt(r.impressions) + "</td>" +
          '<td class="num">' + fmtPct(r.ctr) + "</td>" +
          '<td class="num">' + fmtPos(r.position) + "</td>" +
          "</tr>";
      }).join("") + (shown.length > max ? '<tr><td colspan="6" style="text-align:center;color:#a49cc2;font-size:12px;">Showing first ' + max + " of " + shown.length + " rows — download the CSV for the full set.</td></tr>" : "");
    }

    function statTile(label, value, sub) {
      return '<div class="stat-tile"><div class="stat-label">' + esc(label) + '</div><div class="stat-value">' + value + "</div>" + (sub ? '<div class="stat-sub">' + esc(sub) + "</div>" : "") + "</div>";
    }

    function csvCell(v) {
      var s = v === null || v === undefined ? "" : String(v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    }
    function csvRow(cells) { return cells.map(csvCell).join(","); }

    function triggerDownload(filename, text) {
      var blob = new Blob([text], { type: "text/csv;charset=utf-8" });
      var url = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function downloadCSV() {
      if (!lastDataset) return;
      var header = ["Query/Page", "Segment", "Clicks", "Impressions", "CTR%", "Position"];
      var rows = [header].concat(lastDataset.rows.map(function (r) {
        return [r.query || r.page, r._segment, r.clicks, r.impressions, r.ctr.toFixed(2), isNaN(r.position) ? "" : r.position];
      }));
      triggerDownload("regex-segments.csv", rows.map(csvRow).join("\r\n"));
    }

    els.runBtn.addEventListener("click", runFromFields);
    els.matchField.addEventListener("change", function () {
      if (!lastDataset) return;
      lastMatchField = els.matchField.value;
      activeFilter = null;
      render();
    });

    els.csvText.value = EXAMPLE_CSV;
    runFromFields();
  })();
</script>
