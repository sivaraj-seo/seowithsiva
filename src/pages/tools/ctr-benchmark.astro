---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { safeJsonLd } from '../../utils/schema';

const title = 'CTR Benchmark — Compare Search Console CTR to an Industry Curve';
const description = 'Paste a Search Console export and compare your actual CTR against an editable industry curve, position by position, to find exactly which queries need a title or snippet rewrite.';
const keywords = 'CTR benchmark, Search Console CTR by position, organic CTR curve, SEO tool';

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'CTR Benchmark',
  applicationCategory: 'SEO Tool',
  operatingSystem: 'Any (browser-based)',
  description,
  url: 'https://www.seowithsiva.com/tools/ctr-benchmark/',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  creator: { '@id': 'https://www.seowithsiva.com/#person' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.seowithsiva.com/' },
    { '@type': 'ListItem', position: 2, name: 'Tools', item: 'https://www.seowithsiva.com/tools/' },
    { '@type': 'ListItem', position: 3, name: 'CTR Benchmark', item: 'https://www.seowithsiva.com/tools/ctr-benchmark/' },
  ],
};
---

<BaseLayout {title} {description} {keywords} author="C. Sivaraj">
<Fragment slot="head">
  <script type="application/ld+json" set:html={safeJsonLd(toolSchema)} />
  <script type="application/ld+json" set:html={safeJsonLd(breadcrumbSchema)} />
</Fragment>

<main class="tool-page">
  <div class="tool-wrap">
    <div class="tool-eyebrow">GSC Toolkit · Click-Through Rate</div>
    <h1 class="tool-h1">CTR Benchmark</h1>
    <p class="tool-dek">Paste a Search Console export and compare your <b>actual CTR against an industry curve</b>, position by position — then see exactly which queries are underperforming their rank, worth a title or snippet rewrite.</p>

    <div class="console">
      <section class="panel input-panel">
        <div class="panel-head"><h2>01 · Data</h2></div>
        <div class="input-body">
          <div class="field">
            <label for="csvFile">GSC export</label>
            <span class="hint">Needs Position, Impressions and CTR (or Clicks) — Query or Page level, either works.</span>
            <input type="file" id="csvFile" accept=".csv,text/csv" />
            <textarea id="csvText" spellcheck="false" placeholder="Query,Clicks,Impressions,CTR,Position"></textarea>
            <div class="char-count" id="charCount">0 rows detected</div>
          </div>

          <div class="field">
            <label for="minImpr">Minimum impressions <span class="hint">— filters out noise in the table below</span></label>
            <input type="number" id="minImpr" value="100" min="0" step="10" />
          </div>

          <div class="field">
            <label>Benchmark CTR by position <span class="hint">— edit to match your niche or a study you trust</span></label>
            <div class="bench-grid" id="benchGrid"></div>
            <button class="btn-ghost" id="resetBench" type="button" style="align-self:flex-start;margin-top:2px;">Reset to default</button>
          </div>

          <button class="btn-run" id="runBtn">Analyze →</button>
        </div>
      </section>

      <section class="panel results-panel">
        <div class="panel-head">
          <h2>02 · Gaps</h2>
          <span class="note" id="scopeNote"></span>
        </div>
        <div class="results-body" id="resultsBody"></div>
      </section>
    </div>
  </div>
</main>
</BaseLayout>

<style is:global>
  .tool-page { background: #faf9fd; padding: 56px 24px 100px; }
  .tool-wrap { max-width: 1200px; margin: 0 auto; }

  .tool-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--accent); display: flex; align-items: center; gap: 8px; margin-bottom: 14px; }
  .tool-eyebrow::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); }
  .tool-h1 { font-size: clamp(28px, 4vw, 42px); font-weight: 800; letter-spacing: -.02em; color: var(--ink); margin: 0 0 14px; line-height: 1.15; }
  .tool-dek { max-width: 64ch; color: var(--muted); font-size: 16px; line-height: 1.65; margin: 0; }
  .tool-dek b { color: var(--ink); font-weight: 700; }

  .console { display: grid; grid-template-columns: minmax(300px, 380px) 1fr; gap: 20px; align-items: start; margin-top: 36px; }
  @media (max-width: 900px) { .console { grid-template-columns: 1fr; } }

  .panel { background: #fff; border: 1.5px solid #e4ddf7; border-radius: 16px; box-shadow: 0 2px 16px rgba(124, 92, 214, .06); }
  .panel-head { padding: 16px 20px; border-bottom: 1px solid #efeafc; display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; }
  .panel-head h2 { font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0; }
  .panel-head .note { font-size: 11px; color: #b0a9c8; }

  .input-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  .field label { font-size: 13px; font-weight: 700; color: var(--ink); }
  .field .hint { font-weight: 400; color: #a49cc2; font-size: 12px; }

  input[type="text"], input[type="number"], textarea, select {
    width: 100%; background: #faf9fd; border: 1.5px solid #e4ddf7; border-radius: 10px; color: var(--ink);
    padding: 10px 12px; font-family: inherit; font-size: 13px;
  }
  textarea { resize: vertical; min-height: 170px; font-variant-numeric: tabular-nums; }
  input:focus, textarea:focus, select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(124, 92, 214, .15); }
  input::placeholder, textarea::placeholder { color: #c3bcdb; }
  input[type="file"] { font-size: 12.5px; color: var(--muted); }
  .char-count { font-size: 11px; color: #a49cc2; text-align: right; }

  .bench-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px 10px; }
  .bench-row { display: flex; align-items: center; gap: 6px; }
  .bench-row label { font-size: 11px; color: #a49cc2; width: 44px; flex-shrink: 0; }
  .bench-row input { padding: 6px 8px; font-size: 12px; }

  .btn-run { background: var(--accent); color: #fff; border: none; border-radius: 10px; padding: 13px 18px; font-weight: 700; font-size: 14px; font-family: inherit; cursor: pointer; box-shadow: 0 4px 16px rgba(124, 92, 214, .25); transition: transform .12s, box-shadow .12s; }
  .btn-run:hover { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(124, 92, 214, .32); }
  .btn-run:active { transform: translateY(0); }
  .btn-run:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  .btn-ghost { background: #f0ebfa; color: var(--accent); border: none; border-radius: 9px; padding: 8px 14px; font-weight: 600; font-size: 12.5px; font-family: inherit; cursor: pointer; }
  .btn-ghost:hover { background: var(--accent); color: #fff; }

  .results-body { padding: 22px; }

  .stat-row { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 22px; }
  .stat-tile { flex: 1; min-width: 148px; background: #faf9fd; border: 1px solid #efeafc; border-radius: 12px; padding: 14px 16px; }
  .stat-label { font-size: 10.5px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: #b0a9c8; margin-bottom: 6px; }
  .stat-value { font-size: 24px; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .stat-value.warn { color: #c2571e; }
  .stat-value.good { color: #1a9f4f; }
  .stat-sub { font-size: 11.5px; color: var(--muted); margin-top: 2px; }

  .section-label { font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); margin: 0 0 12px; }

  .chart-block { margin-bottom: 10px; }
  .chart-legend { display: flex; gap: 18px; margin-top: 8px; font-size: 12px; color: var(--muted); flex-wrap: wrap; }
  .chart-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .leg-line { width: 16px; height: 2px; background: var(--accent); display: inline-block; }
  .leg-line.dashed { background: none; border-top: 2px dashed #b0a9c8; }
  .tail-note { font-size: 12.5px; color: var(--muted); margin: 10px 0 24px; padding: 10px 12px; background: #faf9fd; border: 1px solid #efeafc; border-radius: 10px; }
  .tail-note b { color: var(--ink); }

  .table-wrap { overflow-x: auto; border: 1px solid #efeafc; border-radius: 12px; }
  table.data { width: 100%; border-collapse: collapse; font-size: 13px; white-space: nowrap; }
  table.data th { text-align: left; font-size: 10.5px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: #b0a9c8; background: #faf9fd; padding: 10px 12px; border-bottom: 1px solid #efeafc; cursor: pointer; user-select: none; }
  table.data th:hover { color: var(--accent); }
  table.data th.sorted { color: var(--accent); }
  table.data th.num, table.data td.num { text-align: right; font-variant-numeric: tabular-nums; }
  table.data td { padding: 8px 12px; border-bottom: 1px solid #f3f0fa; color: var(--ink); }
  table.data tbody tr:hover td { background: #faf9fd; }
  table.data td.query-cell { white-space: normal; max-width: 320px; }
  table.data td.gap-cell.neg { color: #d6425a; }
  table.data td.gap-cell.pos { color: #1a9f4f; }

  .search-row { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; flex-wrap: wrap; }
  .search-row input { max-width: 260px; }

  .actions { display: flex; gap: 10px; margin-top: 20px; flex-wrap: wrap; }
  .empty-note { font-size: 13.5px; color: var(--muted); padding: 30px 4px; text-align: center; }
</style>

<script>
  (function () {
    "use strict";

    var DEFAULT_CURVE = [28.5, 15.5, 11.0, 8.0, 6.5, 4.5, 3.5, 3.0, 2.5, 2.0];

    var EXAMPLE_CSV = [
      "Query,Clicks,Impressions,CTR,Position",
      "compost bin,210,3400,6.2%,4.8",
      "best compost bin,180,2100,8.6%,3.2",
      "compost bin for apartment,95,1200,7.9%,5.1",
      "how to compost at home,340,9800,3.5%,7.6",
      "what can you compost,120,4100,2.9%,9.3",
      "compost bin reviews,60,900,6.7%,4.4",
      "greenbin co,410,520,78.8%,1.1",
      "greenbin composter,88,140,62.9%,1.3",
      "kitchen compost bin,150,2600,5.8%,6.2",
      "outdoor compost bin,130,2000,6.5%,5.9",
      "compost bin near me,70,1100,6.4%,4.6",
      "tumbling composter vs bin,40,1500,2.7%,11.4",
      "worm compost bin,65,1800,3.6%,8.8",
      "compost bin smell solutions,30,700,4.3%,10.2",
      "small compost bin for apartment,55,600,9.2%,3.8",
      "compost bin size guide,25,500,5.0%,12.1",
      "is composting worth it,90,3200,2.8%,14.5",
      "compost bin vs pile,45,1700,2.6%,13.2"
    ].join("\n");

    function parseCSV(text) {
      var rows = [], row = [], field = "", inQuotes = false;
      for (var i = 0; i < text.length; i++) {
        var c = text[i];
        if (inQuotes) {
          if (c === '"') { if (text[i + 1] === '"') { field += '"'; i++; } else { inQuotes = false; } }
          else field += c;
        } else {
          if (c === '"') inQuotes = true;
          else if (c === ",") { row.push(field); field = ""; }
          else if (c === "\r") { /* skip */ }
          else if (c === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
          else field += c;
        }
      }
      if (field.length || row.length) { row.push(field); rows.push(row); }
      return rows.filter(function (r) { return r.length > 1 || (r.length === 1 && r[0].trim() !== ""); });
    }

    var HEADER_ALIASES = {
      query: ["query", "queries", "top queries", "search query", "search term", "keyword"],
      page: ["page", "pages", "top pages", "landing page", "url"],
      clicks: ["clicks"],
      impressions: ["impressions", "impr."],
      ctr: ["ctr", "click through rate", "click-through rate"],
      position: ["position", "avg position", "average position", "avg. position"]
    };

    function detectColumns(headerRow) {
      var map = {};
      headerRow.forEach(function (h, i) {
        var norm = h.trim().toLowerCase();
        Object.keys(HEADER_ALIASES).forEach(function (canon) {
          if (map[canon] === undefined && HEADER_ALIASES[canon].indexOf(norm) !== -1) map[canon] = i;
        });
      });
      return map;
    }

    function parseNum(s) {
      if (s === undefined || s === null) return NaN;
      var t = String(s).trim().replace(/,/g, "");
      if (t === "") return NaN;
      return parseFloat(t);
    }
    function parseCTR(s) {
      var t = String(s).trim();
      if (t === "") return NaN;
      var hasPct = /%/.test(t);
      var n = parseFloat(t.replace("%", ""));
      if (isNaN(n)) return NaN;
      return hasPct ? n : (n <= 1 ? n * 100 : n);
    }

    function buildDataset(csvText) {
      var raw = parseCSV(csvText.trim());
      if (!raw.length) return null;
      var cols = detectColumns(raw[0]);
      var body = raw.slice(1);
      var rows = body.map(function (r) {
        var row = {
          query: cols.query !== undefined ? (r[cols.query] || "").trim() : "",
          page: cols.page !== undefined ? (r[cols.page] || "").trim() : "",
          clicks: cols.clicks !== undefined ? parseNum(r[cols.clicks]) : NaN,
          impressions: cols.impressions !== undefined ? parseNum(r[cols.impressions]) : NaN,
          ctr: cols.ctr !== undefined ? parseCTR(r[cols.ctr]) : NaN,
          position: cols.position !== undefined ? parseNum(r[cols.position]) : NaN
        };
        if (isNaN(row.clicks)) row.clicks = 0;
        if (isNaN(row.impressions)) row.impressions = 0;
        if (isNaN(row.ctr) && row.impressions > 0) row.ctr = (row.clicks / row.impressions) * 100;
        return row;
      }).filter(function (r) { return r.query || r.page; });
      return {
        rows: rows,
        hasQuery: cols.query !== undefined,
        hasPage: cols.page !== undefined,
        hasPosition: cols.position !== undefined
      };
    }

    function esc(s) { return String(s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); }
    function fmtInt(n) { return Math.round(n).toLocaleString(); }
    function fmtSignedInt(n) { var r = Math.round(n); return (r >= 0 ? "+" : "") + r.toLocaleString(); }
    function fmtPct(n) { return (isFinite(n) ? n.toFixed(1) : "0.0") + "%"; }
    function fmtPos(n) { return n === null || n === undefined || isNaN(n) ? "—" : n.toFixed(1); }

    var curve = DEFAULT_CURVE.slice();
    function benchmarkAt(pos) {
      var p = Math.max(1, pos);
      if (p <= 10) {
        var i = Math.floor(p) - 1, frac = p - Math.floor(p);
        var lo = curve[Math.min(i, 9)], hi = curve[Math.min(i + 1, 9)];
        return lo + (hi - lo) * frac;
      }
      var tail10 = curve[9];
      if (p <= 20) return tail10 - (tail10 * 0.6) * ((p - 10) / 10);
      return tail10 * 0.15;
    }

    var els = {
      csvFile: document.getElementById("csvFile"),
      csvText: document.getElementById("csvText"),
      charCount: document.getElementById("charCount"),
      minImpr: document.getElementById("minImpr"),
      benchGrid: document.getElementById("benchGrid"),
      resetBench: document.getElementById("resetBench"),
      runBtn: document.getElementById("runBtn"),
      resultsBody: document.getElementById("resultsBody"),
      scopeNote: document.getElementById("scopeNote")
    };

    function renderBenchGrid() {
      els.benchGrid.innerHTML = curve.map(function (v, i) {
        return '<div class="bench-row"><label>Pos ' + (i + 1) + '</label><input type="number" class="bench-input" data-idx="' + i + '" value="' + v + '" step="0.1" min="0" max="100" /></div>';
      }).join("");
      els.benchGrid.querySelectorAll(".bench-input").forEach(function (inp) {
        inp.addEventListener("change", function () {
          curve[+inp.dataset.idx] = parseFloat(inp.value) || 0;
          if (lastDataset) render();
        });
      });
    }
    els.resetBench.addEventListener("click", function () {
      curve = DEFAULT_CURVE.slice();
      renderBenchGrid();
      if (lastDataset) render();
    });
    renderBenchGrid();

    els.csvFile.addEventListener("change", function () {
      var file = els.csvFile.files[0];
      if (!file) return;
      var reader = new FileReader();
      reader.onload = function (e) {
        els.csvText.value = String(e.target.result);
        updateCharCount();
        runFromFields();
      };
      reader.readAsText(file);
    });

    function updateCharCount() {
      var lines = els.csvText.value.split("\n").filter(function (l) { return l.trim(); }).length;
      els.charCount.textContent = Math.max(0, lines - 1).toLocaleString() + " rows detected";
    }
    els.csvText.addEventListener("input", updateCharCount);

    var lastDataset = null, lastRows = [], sortKey = "gapClicks", sortDir = 1;

    function runFromFields() {
      var ds = buildDataset(els.csvText.value);
      updateCharCount();
      if (!ds || !ds.rows.length) {
        els.resultsBody.innerHTML = '<div class="empty-note">No rows detected. Paste a Search Console export with a header row, or upload a CSV file.</div>';
        return;
      }
      if (!ds.hasPosition) {
        els.resultsBody.innerHTML = '<div class="empty-note">This export has no Position column — CTR benchmarking needs one to know what to compare against.</div>';
        return;
      }
      lastDataset = ds;
      sortKey = "gapClicks"; sortDir = 1;
      render();
    }

    function render() {
      var ds = lastDataset;
      var minImpr = parseFloat(els.minImpr.value) || 0;

      var withPos = ds.rows.filter(function (r) { return !isNaN(r.position) && r.impressions > 0; }).map(function (r) {
        var bench = benchmarkAt(r.position);
        var expectedClicks = bench / 100 * r.impressions;
        return Object.assign({}, r, { bench: bench, expectedClicks: expectedClicks, gapClicks: r.clicks - expectedClicks, gapPts: r.ctr - bench });
      });

      els.scopeNote.textContent = withPos.length.toLocaleString() + " rows with a position";

      var totalClicks = withPos.reduce(function (a, r) { return a + r.clicks; }, 0);
      var totalImpr = withPos.reduce(function (a, r) { return a + r.impressions; }, 0);
      var totalExpected = withPos.reduce(function (a, r) { return a + r.expectedClicks; }, 0);
      var overallCTR = totalImpr ? (totalClicks / totalImpr * 100) : 0;
      var overallBenchCTR = totalImpr ? (totalExpected / totalImpr * 100) : 0;
      var lostClicks = withPos.filter(function (r) { return r.gapClicks < 0; }).reduce(function (a, r) { return a + -r.gapClicks; }, 0);
      var gainedClicks = withPos.filter(function (r) { return r.gapClicks > 0; }).reduce(function (a, r) { return a + r.gapClicks; }, 0);

      var html = "";
      html += '<div class="stat-row">' +
        statTile("Your overall CTR", fmtPct(overallCTR), "weighted by impressions") +
        statTile("Benchmark-implied CTR", fmtPct(overallBenchCTR), "if every row hit the curve") +
        statTile("Clicks below benchmark", "-" + fmtInt(lostClicks), "across underperforming rows", "warn") +
        statTile("Clicks above benchmark", "+" + fmtInt(gainedClicks), "across overperforming rows", "good") +
        "</div>";

      html += '<div class="chart-block"><div class="section-label">Actual vs. benchmark CTR, positions 1–10</div>' + buildChart(withPos) + "</div>";

      var beyond10 = withPos.filter(function (r) { return r.position > 10; });
      if (beyond10.length) {
        var b1020 = beyond10.filter(function (r) { return r.position <= 20; });
        var b21 = beyond10.filter(function (r) { return r.position > 20; });
        html += '<div class="tail-note">Beyond position 10: <b>' + b1020.length + '</b> rows at 11–20 (avg CTR ' + fmtPct(weightedCTR(b1020)) + ' vs. benchmark ' + fmtPct(weightedBench(b1020)) + ')' +
          (b21.length ? ', <b>' + b21.length + '</b> rows at 21+ (avg CTR ' + fmtPct(weightedCTR(b21)) + ')' : "") + ".</div>";
      }

      var scored = withPos.filter(function (r) { return r.impressions >= minImpr; });
      scored.sort(function (a, b) {
        var av = a[sortKey], bv = b[sortKey];
        var cmp = av < bv ? -1 : av > bv ? 1 : 0;
        return cmp * sortDir;
      });
      lastRows = scored;

      var qKey = ds.hasQuery ? "query" : "page";
      html += '<div class="section-label">Rows ranked by CTR gap (' + scored.length + ')</div>';
      html += '<div class="search-row"><input type="text" id="rowSearch" placeholder="Filter rows…" /></div>';
      html += '<div class="table-wrap"><table class="data"><thead><tr>' +
        th(qKey, ds.hasQuery ? "Query" : "Page") +
        th("position", "Position", true) +
        th("impressions", "Impressions", true) +
        th("ctr", "Actual CTR", true) +
        "<th class=\"num\">Benchmark CTR</th>" +
        th("gapClicks", "Gap (clicks)", true) +
        "</tr></thead><tbody id=\"rowBody\"></tbody></table></div>";

      html += '<div class="actions"><button class="btn-ghost" id="downloadBtn" type="button">Download gap analysis CSV</button></div>';

      els.resultsBody.innerHTML = html;
      renderRowBody(scored, "");

      els.resultsBody.querySelectorAll("th[data-key]").forEach(function (thEl) {
        thEl.addEventListener("click", function () {
          var key = thEl.dataset.key;
          if (sortKey === key) sortDir = -sortDir; else { sortKey = key; sortDir = key === "gapClicks" ? 1 : -1; }
          render();
        });
      });
      var searchInput = document.getElementById("rowSearch");
      if (searchInput) searchInput.addEventListener("input", function () { renderRowBody(scored, searchInput.value); });
      var dl = document.getElementById("downloadBtn");
      if (dl) dl.addEventListener("click", downloadCSV);
    }

    function weightedCTR(rows) {
      var c = rows.reduce(function (a, r) { return a + r.clicks; }, 0);
      var i = rows.reduce(function (a, r) { return a + r.impressions; }, 0);
      return i ? (c / i * 100) : 0;
    }
    function weightedBench(rows) {
      var e = rows.reduce(function (a, r) { return a + r.expectedClicks; }, 0);
      var i = rows.reduce(function (a, r) { return a + r.impressions; }, 0);
      return i ? (e / i * 100) : 0;
    }

    function buildChart(rows) {
      var buckets = [];
      for (var p = 1; p <= 10; p++) {
        var atPos = rows.filter(function (r) { return Math.round(r.position) === p; });
        buckets.push({ pos: p, actual: weightedCTR(atPos), bench: curve[p - 1], n: atPos.length });
      }
      var maxVal = Math.max.apply(null, buckets.map(function (b) { return Math.max(b.actual, b.bench); }).concat([1]));
      var yMax = Math.ceil(maxVal * 1.2 / 5) * 5 || 5;

      var W = 600, H = 230, mL = 38, mR = 14, mT = 14, mB = 30;
      var plotW = W - mL - mR, plotH = H - mT - mB;
      function xAt(i) { return mL + (i / 9) * plotW; }
      function yAt(v) { return mT + plotH - (v / yMax) * plotH; }

      var gridLines = [0, 0.25, 0.5, 0.75, 1].map(function (f) {
        var v = yMax * f, y = yAt(v);
        return '<line x1="' + mL + '" y1="' + y.toFixed(1) + '" x2="' + (W - mR) + '" y2="' + y.toFixed(1) + '" stroke="#efeafc" stroke-width="1" />' +
          '<text x="' + (mL - 8) + '" y="' + (y + 3).toFixed(1) + '" text-anchor="end" font-size="9" fill="#b0a9c8">' + v.toFixed(0) + '%</text>';
      }).join("");

      var xLabels = buckets.map(function (b, i) {
        return '<text x="' + xAt(i).toFixed(1) + '" y="' + (H - mB + 16) + '" text-anchor="middle" font-size="9" fill="#b0a9c8">' + b.pos + '</text>';
      }).join("");

      var benchPath = buckets.map(function (b, i) { return (i === 0 ? "M" : "L") + xAt(i).toFixed(1) + "," + yAt(b.bench).toFixed(1); }).join(" ");
      var actualPath = buckets.map(function (b, i) { return (i === 0 ? "M" : "L") + xAt(i).toFixed(1) + "," + yAt(b.actual).toFixed(1); }).join(" ");

      var actualDots = buckets.map(function (b, i) {
        if (!b.n) return "";
        var over = b.actual >= b.bench;
        var color = over ? "#1a9f4f" : "#d6425a";
        return '<circle cx="' + xAt(i).toFixed(1) + '" cy="' + yAt(b.actual).toFixed(1) + '" r="3.5" fill="' + color + '" stroke="#fff" stroke-width="1.5" />';
      }).join("");

      return '<svg viewBox="0 0 ' + W + ' ' + H + '" width="100%" style="max-width:640px;display:block;">' +
        gridLines + xLabels +
        '<path d="' + benchPath + '" fill="none" stroke="#b0a9c8" stroke-width="1.5" stroke-dasharray="4 3" />' +
        '<path d="' + actualPath + '" fill="none" stroke="#7c5cd6" stroke-width="2" />' +
        actualDots +
        "</svg>" +
        '<div class="chart-legend"><span><span class="leg-line"></span>Your CTR</span><span><span class="leg-line dashed"></span>Benchmark</span><span>● green = at/above benchmark, red = below</span></div>';
    }

    function th(key, label, numeric) {
      var cls = (numeric ? "num " : "") + (sortKey === key ? "sorted" : "");
      var arrow = sortKey === key ? (sortDir === 1 ? " ↑" : " ↓") : "";
      return '<th data-key="' + key + '" class="' + cls.trim() + '">' + esc(label) + arrow + "</th>";
    }

    function renderRowBody(rows, query) {
      var body = document.getElementById("rowBody");
      if (!body) return;
      var q = query.trim().toLowerCase();
      var shown = q ? rows.filter(function (r) { return (r.query + " " + r.page).toLowerCase().indexOf(q) !== -1; }) : rows;
      var max = 400;
      body.innerHTML = shown.slice(0, max).map(function (r) {
        var gapCls = r.gapClicks < 0 ? "neg" : r.gapClicks > 0 ? "pos" : "";
        return "<tr>" +
          '<td class="query-cell">' + esc(r.query || r.page) + "</td>" +
          '<td class="num">' + fmtPos(r.position) + "</td>" +
          '<td class="num">' + fmtInt(r.impressions) + "</td>" +
          '<td class="num">' + fmtPct(r.ctr) + "</td>" +
          '<td class="num">' + fmtPct(r.bench) + "</td>" +
          '<td class="num gap-cell ' + gapCls + '">' + fmtSignedInt(r.gapClicks) + "</td>" +
          "</tr>";
      }).join("") + (shown.length > max ? '<tr><td colspan="6" style="text-align:center;color:#a49cc2;font-size:12px;">Showing first ' + max + " of " + shown.length + " rows — download the CSV for the full set.</td></tr>" : "");
    }

    function statTile(label, value, sub, variant) {
      return '<div class="stat-tile"><div class="stat-label">' + esc(label) + '</div><div class="stat-value' + (variant ? " " + variant : "") + '">' + value + "</div>" + (sub ? '<div class="stat-sub">' + esc(sub) + "</div>" : "") + "</div>";
    }

    function csvCell(v) {
      var s = v === null || v === undefined ? "" : String(v);
      return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
    }
    function csvRow(cells) { return cells.map(csvCell).join(","); }

    function triggerDownload(filename, text) {
      var blob = new Blob([text], { type: "text/csv;charset=utf-8" });
      var url = URL.createObjectURL(blob);
      var a = document.createElement("a");
      a.href = url; a.download = filename;
      document.body.appendChild(a); a.click(); document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    function downloadCSV() {
      if (!lastRows.length) return;
      var header = ["Query/Page", "Position", "Impressions", "Clicks", "Actual CTR%", "Benchmark CTR%", "Gap (clicks)"];
      var rows = [header].concat(lastRows.map(function (r) {
        return [r.query || r.page, r.position.toFixed(1), r.impressions, r.clicks, r.ctr.toFixed(2), r.bench.toFixed(2), r.gapClicks.toFixed(1)];
      }));
      triggerDownload("ctr-benchmark.csv", rows.map(csvRow).join("\r\n"));
    }

    els.runBtn.addEventListener("click", runFromFields);

    els.csvText.value = EXAMPLE_CSV;
    runFromFields();
  })();
</script>
