---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { socialLinks } from '../data/social';
import { safeJsonLd } from '../utils/schema';
import { business } from '../data/business';

const contactPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact C. Sivaraj',
  description: 'Reach C. Sivaraj directly via email for SEO, AEO, and AI search consultations.',
  url: 'https://www.seowithsiva.com/contact/',
  mainEntity: { '@id': 'https://www.seowithsiva.com/#person' },
};

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: business.name,
  url: 'https://www.seowithsiva.com/contact/',
  telephone: business.telephone,
  email: business.email,
  image: 'https://www.seowithsiva.com/images/profile-hero.webp',
  address: {
    '@type': 'PostalAddress',
    addressLocality: business.addressLocality,
    addressRegion: business.addressRegion,
    addressCountry: business.addressCountry,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: business.geo.latitude,
    longitude: business.geo.longitude,
  },
  areaServed: business.areasServed.map((name) => ({ '@type': 'Place', name })),
  sameAs: socialLinks,
};
---

<BaseLayout
  title="Contact"
  description="Reach C. Sivaraj directly via email for SEO, AEO, and AI search consultations."
  keywords="contact, SEO consultant, hire SEO, AEO, GEO, AI search"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={safeJsonLd(contactPageSchema)} />
    <script type="application/ld+json" set:html={safeJsonLd(localBusinessSchema)} />
  </Fragment>
  <main class="contact-main">
   <div class="contact-panel">
    <div class="contact-wrap">

      <Breadcrumb items={[{ name: 'Contact', href: '/contact/' }]} />
      <div class="contact-eyebrow">Contact</div>
      <h1 class="contact-heading">Let's talk about <span>your visibility</span></h1>
      <p class="contact-sub">Whether it's a quick question or a full AI-search audit - just send an email and I'll get back to you within 24 hours.</p>

      <a href="mailto:sivarajc.seo@gmail.com" class="email-card">
        <span class="email-icon">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="3"/>
            <path d="M2 7l10 7 10-7"/>
          </svg>
        </span>
        <span class="email-address">sivarajc.seo@gmail.com</span>
        <span class="email-arrow" aria-hidden="true">&#8599;</span>
      </a>

      <div class="contact-divider"></div>

      <p class="contact-also">Or find me on</p>
      <div class="social-row">
        <a href="https://www.linkedin.com/in/sivaraj-seo-analyst/" target="_blank" class="social-pill">
          <svg viewBox="0 0 24 24" width="14" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 002.5 6a2.5 2.5 0 105 0 2.5 2.5 0 00-2.52-2.5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21H18.6v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H11z"/></svg>
          LinkedIn
        </a>
        <a href="https://x.com/seowithsiva" target="_blank" rel="noopener" class="social-pill">
          <svg viewBox="0 0 24 24" width="14" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          X
        </a>
        <a href="https://www.reddit.com/user/Sivaraj_C/" target="_blank" class="social-pill">
          <svg viewBox="0 0 24 24" width="14" fill="currentColor"><path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.561 1.25 1.249a1.25 1.25 0 0 1-2.498.056l-2.597-.547-.8 3.747c1.824.07 3.48.632 4.674 1.488.308-.309.73-.491 1.207-.491.968 0 1.754.786 1.754 1.754 0 .716-.435 1.333-1.01 1.614a3.111 3.111 0 0 1 .042.52c0 2.694-3.13 4.87-7.004 4.87-3.874 0-7.004-2.176-7.004-4.87 0-.183.015-.366.043-.534A1.748 1.748 0 0 1 4.028 12c0-.968.786-1.754 1.754-1.754.463 0 .898.196 1.207.49 1.207-.883 2.878-1.43 4.744-1.487l.885-4.182a.342.342 0 0 1 .14-.197.35.35 0 0 1 .238-.042l2.906.617a1.214 1.214 0 0 1 1.108-.701zM9.25 12C8.561 12 8 12.562 8 13.25c0 .687.561 1.248 1.25 1.248.687 0 1.248-.561 1.248-1.249 0-.688-.561-1.249-1.249-1.249zm5.5 0c-.687 0-1.248.561-1.248 1.25 0 .687.561 1.248 1.249 1.248.688 0 1.249-.561 1.249-1.249 0-.687-.562-1.249-1.25-1.249zm-5.466 3.99a.327.327 0 0 0-.231.094.33.33 0 0 0 0 .463c.842.842 2.484.913 2.961.913.477 0 2.105-.056 2.961-.913a.361.361 0 0 0 .029-.463.33.33 0 0 0-.464 0c-.547.533-1.684.73-2.512.73-.828 0-1.979-.196-2.512-.73a.326.326 0 0 0-.232-.095z"/></svg>
          Reddit
        </a>
        <a href="https://www.instagram.com/seowithsiva/" target="_blank" rel="noopener" class="social-pill">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.64-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>
          Instagram
        </a>
        <a href="https://wa.link/l9kdx1" target="_blank" class="social-pill social-pill--wa">
          <svg viewBox="0 0 24 24" width="14" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.6-.8-1.9-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.9-.2-.3 0-.4.1-.6l.4-.4c.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.1 0 1.2.9 2.4 1 2.6.1.2 1.8 2.8 4.5 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.6-.6 1.8-1.3.2-.6.2-1.2.2-1.3-.1-.2-.3-.2-.5-.3z"/><path d="M12 2a10 10 0 00-8.5 15.2L2 22l4.9-1.3A10 10 0 1012 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1112 20.2z"/></svg>
          WhatsApp
        </a>
      </div>

      <div class="contact-divider"></div>

      <p class="contact-also">Serving</p>
      <div class="social-row">
        <span class="area-pill area-pill--primary">{business.primaryArea}</span>
        {business.areasServed
          .filter((area) => area !== business.primaryArea)
          .map((area) => (
            <span class="area-pill">{area}</span>
          ))}
      </div>

    </div>
   </div>
  </main>
</BaseLayout>

<style>
  .contact-main {
    padding: 24px 32px 40px;
  }
  .contact-panel {
    max-width: 1136px; margin: 0 auto;
    display: grid; grid-template-columns: 1fr; gap: 48px; align-items: center;
    background: linear-gradient(180deg, var(--primary-light), var(--surface));
    border-radius: 28px; padding: 64px 56px; overflow: hidden;
  }
  .contact-wrap { min-width: 0; }

  .contact-eyebrow { font-size: 12px; color: var(--muted); letter-spacing: .02em; margin-bottom: 14px; }
  .contact-eyebrow::before { content: '['; }
  .contact-eyebrow::after { content: ']'; }
  .contact-heading {
    font-size: clamp(34px, 4.6vw, 54px); font-weight: 600; color: var(--ink);
    line-height: 1.1; letter-spacing: -.03em; margin: 0 0 18px;
  }
  .contact-heading span { color: var(--primary); }
  .contact-sub { font-size: 15px; color: var(--muted); line-height: 1.7; margin: 0 0 32px; max-width: 46ch; }

  .email-card {
    display: flex; align-items: center; gap: 14px;
    background: #fff; border: 1px solid var(--border);
    border-radius: 999px; padding: 8px 8px 8px 22px;
    text-decoration: none; max-width: 440px;
    transition: border-color .15s, transform .15s;
  }
  .email-card:hover { border-color: var(--primary); transform: translateY(-1px); }
  .email-icon { color: var(--primary); flex-shrink: 0; display: flex; }
  .email-address { font-size: 15px; font-weight: 600; color: var(--ink); flex: 1; text-align: left; overflow-wrap: anywhere; }
  .email-arrow {
    width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0;
    background: var(--primary); color: #fff; font-size: 18px; line-height: 1;
    display: inline-flex; align-items: center; justify-content: center;
  }

  .contact-divider { height: 0; margin: 34px 0 0; }
  .contact-also { font-size: 12px; font-weight: 600; color: var(--muted); margin: 0 0 12px; }

  .social-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .social-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 8px 14px; border-radius: 999px;
    font-size: 12.5px; font-weight: 600;
    background: #fff; border: 1px solid var(--border); color: var(--ink-light);
    text-decoration: none; transition: border-color .14s, color .14s;
  }
  .social-pill:hover { border-color: var(--primary); color: var(--primary); }
  .social-pill--wa { color: #1a9f4f; }
  .social-pill--wa:hover { border-color: #25D366; color: #1a9f4f; }

  .area-pill {
    display: inline-flex; align-items: center;
    padding: 8px 14px; border-radius: 999px;
    font-size: 12.5px; font-weight: 600;
    background: rgba(255,255,255,.7); color: var(--ink-light);
  }
  .area-pill--primary { background: var(--primary); color: #fff; }

  .contact-photo { position: relative; display: flex; justify-content: center; align-self: end; margin-bottom: -64px; }
  .contact-photo::before {
    content: ''; position: absolute; left: 50%; bottom: 0; width: 110%; aspect-ratio: 1;
    transform: translate(-50%, 20%);
    background: radial-gradient(circle, rgba(24,119,242,.3) 0%, rgba(24,119,242,.08) 40%, transparent 68%);
  }
  .contact-photo img { position: relative; width: 100%; max-width: 360px; height: auto; display: block; }
  .reply-card {
    position: absolute; left: 0; top: 30%; z-index: 2;
    background: #fff; border-radius: 16px; padding: 12px 16px;
    box-shadow: 0 18px 40px -20px rgba(17,20,24,.35);
  }
  .reply-card b { display: block; font-size: 20px; letter-spacing: -.03em; color: var(--primary); }
  .reply-card span { font-size: 11px; color: var(--muted); }

  @media (max-width: 900px) {
    .contact-panel { grid-template-columns: 1fr; padding: 44px 28px 0; }
    .contact-photo { margin: 0 auto; max-width: 340px; }
  }
  @media (max-width: 480px) {
    .contact-main { padding: 16px 14px 24px; }
    .contact-panel { padding: 36px 20px 0; border-radius: 22px; }
    .email-address { font-size: 13.5px; }
  }
</style>
