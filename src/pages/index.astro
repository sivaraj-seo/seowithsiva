---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { safeJsonLd } from '../utils/schema';
import { getImageDims } from '../data/imageDims';

const title = 'C. Sivaraj – SEO Analyst & AEO / GEO Specialist';
const description =
  'SEO & AI-search analyst helping brands earn visibility across Google AI Overviews, ChatGPT, Gemini, Perplexity, Bing AI & Copilot, backed by 7+ years enterprise SEO.';
const keywords =
  'SEO analyst, AEO, GEO, AI search optimization, enterprise SEO, Google AI Overviews, generative engine optimization, C. Sivaraj';

const callUrl = 'https://calendar.app.google/FwUxXeGAFCdvuvGN6';
const citeGuide = '/blog/cite-framework-get-cited-in-ai-overviews/';

const services = [
  {
    name: 'AI Search Optimization (AEO / GEO)',
    text: 'Make your content the cited answer in Google AI Overviews, ChatGPT, Gemini, Perplexity, Bing AI and Copilot.',
    icon: '<circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.6 5.6l2.1 2.1M16.3 16.3l2.1 2.1M18.4 5.6l-2.1 2.1M7.7 16.3l-2.1 2.1"/>',
  },
  {
    name: 'Enterprise SEO',
    text: 'Scalable optimization frameworks and governance across tens of thousands of indexed pages.',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18M9 9v11"/>',
  },
  {
    name: 'Technical SEO',
    text: 'Audits across crawl, indexation, metadata, schema, redirects, XML sitemaps and internal linking.',
    icon: '<path d="M10 13a5 5 0 007 0l3-3a5 5 0 00-7-7l-1 1"/><path d="M14 11a5 5 0 00-7 0l-3 3a5 5 0 007 7l1-1"/>',
  },
  {
    name: 'Content Strategy',
    text: 'Topic clusters, search-intent mapping, content briefs and editorial systems that earn topical authority.',
    icon: '<path d="M5 7h14M5 12h14M5 17h8"/>',
  },
  {
    name: 'Semantic & Entity SEO',
    text: 'Entity optimization, structured data and semantic relevance that AI engines can understand and trust.',
    icon: '<circle cx="7" cy="7" r="2"/><circle cx="17" cy="7" r="2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M9 7h6M7 9v6M9 17h6"/>',
  },
  {
    name: 'Analytics & Reporting',
    text: 'GSC, GA4, Ahrefs, SEMrush and Looker Studio dashboards tying organic and AI visibility to outcomes.',
    icon: '<path d="M6 20v-8M12 20V6M18 20v-11"/>',
  },
];

const truths = [
  {
    text: 'Ranking isn’t the gate. Rank-to-citation overlap sits between <b>17% and 54%</b>, so pages on page two can still get cited.',
    icon: '<circle cx="11" cy="11" r="7"/><path d="M16 16l5 5M8 11h6M11 8v6"/>',
  },
  {
    text: 'On queries that show AI Overviews, top positions lose <b>30–50% of their CTR</b> on average.',
    icon: '<path d="M4 6l6 6 4-4 6 6"/><path d="M20 9v5h-5"/>',
  },
  {
    text: 'Brands with active trust profiles see a <b>75x citation gap</b> over those without them.',
    icon: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/><path d="M9 12l2 2 4-4"/>',
  },
];

const cases = [
  {
    tag: 'Healthcare · GEO / AEO',
    client: 'GEO / AEO pilot',
    sub: 'Enterprise healthcare publisher',
    metric: '+1,050%',
    metricLabel: 'Organic sessions',
    body: [
      'Led a GEO/AEO pilot across 60 high-value healthcare articles, restructuring them for passage-level extraction, entity clarity and trust signals.',
      'The framework was then adopted site-wide across Google, Bing and AI platforms.',
    ],
    path: 'M0 70 C 40 68, 70 64, 100 58 S 170 40, 200 30 S 260 8, 300 4',
  },
  {
    tag: 'AI citations · Google & Bing',
    client: 'AI-first content framework',
    sub: 'Enterprise content programme',
    metric: '12M+',
    metricLabel: 'Google AI citations',
    body: [
      'Rolled out AI-first content frameworks that earned 12M+ Google generative-AI citations and 1M+ Bing AI citations in 28 days.',
      'Content teams kept the gains with an LLM Content Optimization Checklist built for every new brief.',
    ],
    path: 'M0 72 C 50 70, 80 66, 120 50 S 180 30, 220 22 S 270 12, 300 6',
  },
  {
    tag: 'Reporting · Looker Studio',
    client: 'Executive SEO dashboards',
    sub: 'Cross-functional stakeholders',
    metric: '80%',
    metricLabel: 'Less reporting effort',
    body: [
      'Built executive dashboards in Google Looker Studio that pull GSC, GA4 and AI-visibility data into one view.',
      'Manual SEO reporting effort dropped by 80% and stakeholders finally saw organic and AI performance side by side.',
    ],
    path: 'M0 20 C 50 22, 90 30, 130 42 S 200 60, 240 66 S 280 70, 300 72',
  },
];

const allArticles = await getCollection('articles');
const latest = allArticles
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  name: title,
  description,
  url: 'https://www.seowithsiva.com/',
  mainEntity: { '@id': 'https://www.seowithsiva.com/#person' },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'SEO, AEO & GEO Consulting',
  name: 'SEO, AEO & GEO Consulting',
  description:
    'Remote SEO, AEO and GEO consulting for brands seeking visibility in Google, AI Overviews, ChatGPT, Gemini, Perplexity, Bing AI and Copilot.',
  provider: { '@id': 'https://www.seowithsiva.com/#person' },
  areaServed: 'Worldwide',
  availableChannel: {
    '@type': 'ServiceChannel',
    serviceUrl: 'https://www.seowithsiva.com/contact/',
    availableLanguage: ['English'],
  },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'SEO Services',
    itemListElement: services.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name },
    })),
  },
};
---

<BaseLayout {title} {description} {keywords} author="C. Sivaraj">

<Fragment slot="head">
  <link rel="preload" as="image" href="/images/profile-home-hero.webp" fetchpriority="high" />
  <script type="application/ld+json" set:html={safeJsonLd(profilePageSchema)} />
  <script type="application/ld+json" set:html={safeJsonLd(serviceSchema)} />
</Fragment>

<style>
  h1, h2, h3 { margin: 0; letter-spacing: -.025em; line-height: 1.15; font-weight: 600; color: var(--ink); }
  p { margin: 0; }
  ::selection { background: var(--primary); color: #fff; }

  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
  .blue { color: var(--primary); }
  .kicker { font-size: 12px; color: var(--muted); letter-spacing: .02em; }
  .kicker::before { content: '['; }
  .kicker::after { content: ']'; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--primary);
    color: #fff;
    font-size: 13.5px;
    font-weight: 600;
    padding: 11px 20px;
    border-radius: 999px;
    text-decoration: none;
    box-shadow: 0 8px 20px -8px rgba(24, 119, 242, .7);
    transition: background .15s, transform .15s;
    border: 0;
    cursor: pointer;
  }
  .btn:hover { background: var(--primary-dark); transform: translateY(-1px); }
  .btn svg { flex: none; }

  .panel { background: var(--surface); border-radius: 28px; }

  /* ── HERO ── */
  .hero { position: relative; overflow: hidden; padding-top: 8px; }
  .hero-name {
    position: absolute;
    inset: 0 0 auto;
    text-align: center;
    font-size: clamp(90px, 17vw, 240px);
    font-weight: 700;
    letter-spacing: -.06em;
    line-height: .9;
    padding-bottom: .2em;
    color: transparent;
    background: linear-gradient(180deg, #e7eaef 0%, #f1f3f6 75%, rgba(255,255,255,0) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1fr minmax(320px, 480px) 1fr;
    align-items: end;
    gap: 24px;
    min-height: 620px;
  }
  .hero-photo { position: relative; align-self: end; display: flex; justify-content: center; }
  .hero-photo::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 120%;
    aspect-ratio: 1;
    transform: translate(-50%, 18%);
    background: radial-gradient(circle, rgba(24,119,242,.28) 0%, rgba(24,119,242,.10) 38%, rgba(255,255,255,0) 68%);
    z-index: 0;
  }
  .hero-photo img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: auto;
    max-height: 600px;
    object-fit: contain;
    object-position: bottom;
    display: block;
    margin-top: 90px;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 10%, #000 90%, transparent 100%), linear-gradient(180deg, #000 78%, transparent 97%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(90deg, transparent 0, #000 10%, #000 90%, transparent 100%), linear-gradient(180deg, #000 78%, transparent 97%);
    mask-composite: intersect;
  }
  .hero-card {
    align-self: center;
    max-width: 280px;
    background: rgba(243,245,248,.85);
    backdrop-filter: blur(8px);
    border-radius: 22px;
    padding: 26px;
    margin-top: 140px;
  }
  .hero-card h2 { font-size: 20px; line-height: 1.25; }
  .hero-card p { font-size: 13px; line-height: 1.6; color: var(--muted); margin: 10px 0 18px; }
  .hero-side { align-self: center; justify-self: end; max-width: 300px; margin-top: 140px; }
  .hero-side h1 { font-size: 24px; line-height: 1.25; }
  .hero-side p { font-size: 13.5px; line-height: 1.65; color: var(--muted); margin-top: 14px; }
  .hero-side p b { color: var(--primary); font-weight: 600; }
  .hero-stat {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 26px;
    font-size: 40px;
    font-weight: 700;
    letter-spacing: -.04em;
    color: var(--primary);
    line-height: 1;
  }
  .hero-stat-lbl { font-size: 12.5px; color: var(--muted); margin-top: 6px !important; }
  .squiggle { display: block; margin-top: 8px; }

  /* ── SERIOUS ── */
  .serious { margin-top: 0; }
  @media (max-width: 960px) { .serious { margin-top: 48px; } }
  .serious .panel {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    padding: 56px;
    align-items: center;
  }
  .serious h2 { font-size: clamp(28px, 3.4vw, 42px); line-height: 1.2; }
  .ring { position: relative; display: inline-block; padding: 0 6px; margin: 0 8px; }
  .ring svg { position: absolute; inset: -12px -10px; width: calc(100% + 20px); height: calc(100% + 24px); overflow: visible; }
  .uline { background: linear-gradient(var(--primary), var(--primary)) 0 92%/100% 3px no-repeat; }
  .serious-lead { font-size: 14.5px; line-height: 1.7; color: var(--muted); margin-top: 40px !important; max-width: 52ch; }
  .serious-lead b { color: var(--primary); font-weight: 600; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .chip { font-size: 12px; font-weight: 600; background: #fff; border: 1px solid var(--border); border-radius: 999px; padding: 6px 12px; color: var(--ink-light); }
  .serious-ctas { display: flex; align-items: center; gap: 18px; margin-top: 30px; flex-wrap: wrap; }
  .serious-note { display: flex; align-items: center; gap: 10px; font-size: 12px; color: var(--muted); line-height: 1.4; max-width: 30ch; }
  .serious-img { border-radius: 22px; overflow: hidden; aspect-ratio: 4 / 4.2; }
  .serious-img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* ── TRUTHS ── */
  .truths { padding-top: 110px; text-align: center; }
  .truths-head { position: relative; max-width: 760px; margin: 0 auto; }
  .truths-head h2 { font-size: clamp(28px, 3.4vw, 40px); margin-top: 14px; }
  .arrow { position: absolute; top: 40px; width: 90px; color: var(--primary); }
  .arrow.l { left: -60px; }
  .arrow.r { right: -60px; transform: scaleX(-1); }
  .truths-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    max-width: 860px;
    margin: 56px auto 0;
  }
  .truth {
    background: var(--surface);
    border-radius: 20px;
    padding: 32px 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .truth-ico {
    width: 72px; height: 72px;
    border-radius: 20px;
    background: #fff;
    display: flex; align-items: center; justify-content: center;
    color: var(--ink);
  }
  .truth p { font-size: 13px; line-height: 1.6; color: var(--ink-light); }
  .truth p b { color: var(--primary); font-weight: 600; }
  .truths-src { font-size: 12px; color: var(--muted); margin-top: 18px !important; }
  .truths-src a { color: var(--primary); }

  .brief {
    max-width: 860px;
    margin: 28px auto 0;
    padding: 40px 32px;
    background: linear-gradient(180deg, var(--primary-light), var(--surface));
    border-radius: 22px;
  }
  .brief h3 { font-size: 21px; }
  .brief > p { font-size: 13.5px; color: var(--muted); margin: 12px auto 22px; max-width: 46ch; line-height: 1.6; }
  .brief > p b { color: var(--primary); font-weight: 600; }
  .brief-links { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
  .btn.ghost { background: #fff; color: var(--ink); box-shadow: none; border: 1px solid var(--border); }
  .btn.ghost:hover { border-color: var(--primary); color: var(--primary); background: #fff; }

  /* ── CASE STUDIES ── */
  .cases { padding-top: 110px; }
  .cases .panel {
    padding: 48px 0 40px 48px;
    background: linear-gradient(180deg, #eef4fd 0%, var(--surface) 55%);
    overflow: hidden;
  }
  .cases h2 { font-size: clamp(24px, 2.8vw, 34px); margin-top: 12px; max-width: 24ch; }
  .case-viewport { margin-top: 40px; overflow: hidden; }
  .case-track {
    display: flex;
    gap: 24px;
    transition: transform .5s cubic-bezier(.2,.8,.2,1);
  }
  .case {
    flex: 0 0 calc(100% - 140px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
    background: #fff;
    border-radius: 22px;
    padding: 16px;
  }
  .case-visual {
    background: var(--dark);
    border-radius: 16px;
    padding: 28px;
    color: #fff;
    min-height: 260px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }
  .case-visual::after {
    content: '';
    position: absolute;
    inset: auto -20% -60% auto;
    width: 300px; height: 300px;
    background: radial-gradient(circle, rgba(24,119,242,.45), transparent 65%);
  }
  .cv-tag { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #8fb8ff; }
  .cv-metric { font-size: clamp(40px, 5vw, 60px); font-weight: 700; letter-spacing: -.045em; line-height: 1; margin-top: 16px; }
  .cv-lbl { font-size: 13px; color: #b8c3d4; margin-top: 6px; }
  .cv-chart { width: 100%; height: 80px; margin-top: 18px; position: relative; z-index: 1; }
  .case-body { padding: 12px 24px 12px 0; }
  .case-body h3 { font-size: 18px; color: var(--primary); }
  .case-sub { font-size: 11.5px; color: var(--muted); margin-top: 4px !important; }
  .case-body p:not(.case-sub) { font-size: 13.5px; line-height: 1.7; color: var(--ink-light); margin-top: 16px; }
  .cases-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
    padding-right: 48px;
    flex-wrap: wrap;
  }
  .cases-foot p { font-size: 13px; color: var(--muted); max-width: 40ch; line-height: 1.55; }
  .cases-foot p b { color: var(--ink); }
  .slider-btns { display: flex; gap: 12px; }
  .sbtn {
    width: 42px; height: 42px;
    border-radius: 50%;
    border: 0;
    background: var(--primary);
    color: #fff;
    display: inline-flex; align-items: center; justify-content: center;
    cursor: pointer;
    transition: background .15s, opacity .15s;
  }
  .sbtn:hover { background: var(--primary-dark); }
  .sbtn:disabled { opacity: .35; cursor: default; }

  /* ── SERVICES ── */
  .services { padding-top: 120px; }
  .services .wrap { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: start; }
  .services-intro { position: sticky; top: 110px; }
  .services-intro h2 { font-size: clamp(30px, 3.4vw, 42px); margin-top: 12px; }
  .services-intro p { font-size: 14px; line-height: 1.7; color: var(--muted); margin-top: 18px; max-width: 34ch; }
  .services-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .svc {
    background: var(--surface);
    border-radius: 22px;
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    transition: transform .2s, box-shadow .2s;
  }
  .svc:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -24px rgba(17,20,24,.35); }
  .svc-ico {
    width: 52px; height: 52px;
    border-radius: 14px;
    border: 1.5px solid var(--ink);
    display: flex; align-items: center; justify-content: center;
    color: var(--ink);
    background: #fff;
  }
  .svc h3 { font-size: 16px; color: var(--primary); margin-top: 22px; }
  .svc p { font-size: 13px; line-height: 1.7; color: var(--muted); margin: 12px 0 24px; flex: 1; }
  .svc .btn { align-self: flex-start; padding: 9px 16px; font-size: 12.5px; }

  /* ── ABOUT (testimonial-style) ── */
  .about { padding-top: 120px; }
  .about .wrap { display: grid; grid-template-columns: 1fr 1.9fr; gap: 48px; }
  .about-left { display: flex; flex-direction: column; justify-content: space-between; gap: 40px; }
  .about-left h2 { font-size: clamp(30px, 3.4vw, 42px); margin-top: 12px; }
  .about-proof { display: flex; align-items: center; gap: 14px; }
  .about-proof-badges { display: flex; }
  .about-proof-badges span {
    width: 40px; height: 40px;
    border-radius: 50%;
    border: 2px solid #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 11px; font-weight: 700; color: #fff;
    margin-left: -10px;
  }
  .about-proof-badges span:first-child { margin-left: 0; }
  .about-proof b { font-size: 18px; display: block; line-height: 1.1; }
  .about-proof small { font-size: 12px; color: var(--primary); }
  .about-card { padding: 28px; display: grid; grid-template-columns: 1fr 1.15fr; gap: 36px; align-items: center; }
  .about-photo { border-radius: 18px; overflow: hidden; aspect-ratio: 1; }
  .about-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .quote-mark { width: 44px; color: var(--primary); opacity: .5; }
  .about-quote p { font-size: 14px; line-height: 1.75; color: var(--ink-light); margin-top: 16px; }
  .about-quote p b { color: var(--primary); font-weight: 600; }
  .about-sig { margin-top: 22px; }
  .about-sig strong { display: block; color: var(--primary); font-size: 15px; font-weight: 600; }
  .about-sig span { font-size: 12px; color: var(--muted); }
  .about-sig a { display: inline-block; margin-top: 14px; font-size: 13px; font-weight: 600; color: var(--primary); text-decoration: none; }

  /* ── BLOG ── */
  .blog { padding-top: 120px; }
  .blog-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
  .blog-head h2 { font-size: clamp(28px, 3.2vw, 40px); margin-top: 12px; }
  .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; margin-top: 40px; }
  .post {
    background: var(--surface);
    border-radius: 22px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    transition: transform .2s, box-shadow .2s;
  }
  .post:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -24px rgba(17,20,24,.35); }
  .post img { width: 100%; height: auto; aspect-ratio: 1200 / 630; object-fit: cover; display: block; }
  .post-body { padding: 22px 22px 26px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .post-meta { font-size: 11.5px; color: var(--muted); }
  .post h3 { font-size: 16px; line-height: 1.35; }
  .post-more { margin-top: auto; font-size: 13px; font-weight: 600; color: var(--primary); padding-top: 6px; }

  /* ── CTA BANNER ── */
  .cta-banner { padding-top: 120px; }
  .cta-banner .panel {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    overflow: hidden;
    position: relative;
    min-height: 300px;
  }
  .cta-copy { padding: 56px; }
  .cta-copy h2 { font-size: clamp(26px, 3vw, 36px); line-height: 1.2; }
  .cta-copy p { font-size: 13.5px; color: var(--muted); margin: 16px 0 26px; max-width: 42ch; line-height: 1.6; }
  .cta-copy p a { color: var(--primary); text-decoration: none; }
  .cta-art { align-self: stretch; position: relative; min-height: 300px; }
  .cta-screen {
    position: absolute;
    top: 44px; left: 40px; right: -60px; bottom: -60px;
    background: linear-gradient(160deg, #13253f, #0a1424);
    border-radius: 28px;
    transform: perspective(900px) rotateY(-14deg) rotateX(6deg) rotate(-4deg);
    box-shadow: -30px 30px 60px -30px rgba(10,20,36,.6);
    padding: 34px;
    color: #fff;
  }
  .cta-screen .num { font-size: 42px; font-weight: 700; letter-spacing: -.04em; line-height: 1; }
  .cta-screen .lbl { font-size: 12px; color: #9fb2cc; margin-top: 6px; }
