---
import BaseLayout from '../layouts/BaseLayout.astro';
import { socialLinks } from '../data/social';

const title = 'About C. Sivaraj – SEO Analyst & AEO / GEO Specialist';
const description = "I'm C. Sivaraj, an SEO Analyst and AEO/GEO specialist with 5+ years of enterprise SEO experience helping brands rank in Google, ChatGPT, and Perplexity.";
const keywords = 'C. Sivaraj, SEO analyst, AEO, GEO, AI search optimization, enterprise SEO';

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description,
  url: 'https://www.seowithsiva.com/about/',
  mainEntity: {
    '@type': 'Person',
    name: 'C. Sivaraj',
    url: 'https://www.seowithsiva.com',
    sameAs: socialLinks,
  },
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
  </Fragment>
  <main>
    <section class="hero">
      <div class="container">
        <h1>About C. Sivaraj</h1>
        <p>SEO Analyst · AEO / GEO Specialist · 5+ years of enterprise SEO</p>
      </div>
    </section>

    <section class="content">
      <div class="container">
        <article>
          <h2>My Story</h2>
          <p>
            I'm Sivaraj — an SEO Analyst based in Coimbatore, India. I hold an MBA in Marketing from
            Kongu Engineering College and a BSc in Computer Science from SNR Sons College, a
            combination that's shaped how I approach SEO: half technical execution, half business
            strategy. I currently lead enterprise SEO and GEO at Orane Healthcare India, and
            previously managed SEO for 25+ client sites across healthcare, SaaS, and services at
            Boostability India.
          </p>
          <p>
            As search fragmented across Google, ChatGPT, Gemini, and Perplexity, I shifted from
            pure ranking-focused SEO toward AEO and GEO — helping brands earn visibility not just in
            blue links, but in AI Overviews and AI-generated answers directly.
          </p>

          <h2>My Mission</h2>
          <p>
            I believe in giving businesses the knowledge and tools to compete effectively online —
            not black-box tactics, but transparent, actionable guidance that delivers measurable
            results across both traditional rankings and AI citations.
          </p>

          <h2>My Values</h2>
          <ul>
            <li><strong>Transparency:</strong> Clear communication about what I'm doing and why it works</li>
            <li><strong>Ethics:</strong> White-hat SEO practices only — no shortcuts that risk your site</li>
            <li><strong>Excellence:</strong> Continuous learning as search itself keeps changing</li>
            <li><strong>Results:</strong> Focused on measurable outcomes — traffic, rankings, and AI citations</li>
          </ul>

          <h2>Credentials</h2>
          <ul>
            <li><strong>Generative Engine Content Optimization</strong> — Edureka</li>
            <li><strong>Enterprise Answer Engine Optimization</strong> — seoClarity</li>
          </ul>

          <h2>Why Work With Me?</h2>
          <p>
            With 5+ years across enterprise healthcare, SaaS, and services SEO, I understand what it
            takes to rank in today's competitive, AI-influenced search landscape. I combine technical
            SEO depth with the strategic and entity-optimization work that AI search engines now
            reward.
          </p>
        </article>
      </div>
    </section>
  </main>

</BaseLayout>

<style>
  .hero {
    background: linear-gradient(135deg, #7c5cd6 0%, #5a4ab8 100%);
    color: white;
    text-align: center;
    padding: 4rem 2rem;
  }

  .hero h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .hero p {
    font-size: 1.2rem;
    opacity: 0.9;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
  }

  .content {
    padding: 4rem 2rem;
    background: white;
  }

  article {
    line-height: 1.8;
  }

  h2 {
    color: #7c5cd6;
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.8rem;
  }

  p {
    margin-bottom: 1.5rem;
    color: #333;
  }

  ul {
    margin-left: 2rem;
    margin-bottom: 1.5rem;
  }

  li {
    margin-bottom: 1rem;
    color: #333;
  }

  strong {
    color: #7c5cd6;
  }

  footer {
    background: #2a2a2a;
    color: white;
    padding: 2rem;
    text-align: center;
    margin-top: auto;
  }

  footer .container {
    max-width: 1200px;
  }

  footer nav {
    margin-top: 1rem;
    display: flex;
    gap: 2rem;
    justify-content: center;
  }

  footer a {
    color: #bbb;
    text-decoration: none;
    transition: color 0.3s ease;
  }

  footer a:hover {
    color: white;
  }

  @media (max-width: 768px) {
    .hero h1 {
      font-size: 1.8rem;
    }

    .hero p {
      font-size: 1rem;
    }

    h2 {
      font-size: 1.5rem;
    }
  }
</style>
