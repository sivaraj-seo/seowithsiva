---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'About C. Sivaraj – SEO Analyst & AEO / GEO Specialist';
const description = "I'm C. Sivaraj, an SEO Analyst and AEO/GEO specialist with 5+ years of enterprise SEO experience helping brands rank in Google, ChatGPT, and Perplexity.";
const keywords = 'C. Sivaraj, SEO analyst, AEO, GEO, AI search optimization, enterprise SEO';

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description,
  url: 'https://www.seowithsiva.com/about/',
  mainEntity: { '@id': 'https://www.seowithsiva.com/#person' },
};
---

<BaseLayout {title} {description} {keywords} author="C. Sivaraj">

<Fragment slot="head">
  <script type="application/ld+json" set:html={JSON.stringify(aboutPageSchema)} />
</Fragment>

<style>
  *{ box-sizing:border-box; }
  h1,h2,h3{ margin:0; letter-spacing:-.02em; line-height:1.08; }
  p{ margin:0; }
  a{ color:inherit; text-decoration:none; }

  .wrap{ max-width:1120px; margin:0 auto; padding:0 32px; }
  .em{ color:var(--accent); }
  .ulink{ background:linear-gradient(var(--accent),var(--accent)) 0 92%/100% 2px no-repeat; }

  .pill{
    display:inline-flex; align-items:center; gap:8px;
    border-radius:999px; font-weight:600; font-size:15px;
    padding:14px 26px; transition:transform .18s, box-shadow .18s;
    cursor:pointer;
  }
  .pill:hover{ transform:translateY(-2px); }
  .cta{ background:var(--cta); color:#fff; box-shadow:0 10px 24px -8px rgba(236,109,146,.6); }
  .cta:hover{ box-shadow:0 14px 30px -8px rgba(236,109,146,.7); }
  .ghost{ background:#fff; color:var(--ink); box-shadow:0 6px 20px -10px rgba(33,29,51,.4); }

  .tag{
    display:inline-flex; align-items:center; gap:7px;
    font-size:12px; font-weight:700; letter-spacing:.12em;
    text-transform:uppercase; color:var(--accent);
  }
  .tag::before{ content:''; width:7px; height:7px; border-radius:50%; background:var(--accent); }

  .card{
    background:#fff; border-radius:22px;
    box-shadow:0 18px 50px -28px rgba(33,29,51,.45);
    transition:transform .22s, box-shadow .22s;
  }
  .lift:hover{ transform:translateY(-6px); box-shadow:0 30px 60px -28px rgba(33,29,51,.5); }

  .ico{
    width:54px; height:54px; border-radius:15px;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
  }

  .hsoc{
    display:inline-flex; align-items:center; gap:8px;
    transition:transform .15s, color .15s, box-shadow .15s;
  }
  .hsoc:hover{ color:var(--accent); transform:translateY(-2px); box-shadow:0 8px 18px -8px rgba(33,29,51,.55); }

  @keyframes float{ 0%,100%{ transform:translateY(0) } 50%{ transform:translateY(-14px) } }
  .floaty{ animation:float 5.5s ease-in-out infinite; }
  @keyframes scrollx{ from{ transform:translateX(0) } to{ transform:translateX(-50%) } }

  .clouds{
    height:38px;
    background:radial-gradient(circle 22px at 22px 38px,#fff 0 22px,transparent 23px) 0 0/44px 38px repeat-x;
  }

  /* ── HERO ── */
  .hero{
    background:linear-gradient(165deg,#efeafc 0%,#f7ecf2 52%,#fde9dc 100%);
    position:relative; overflow:hidden;
  }
  .hero-inner{
    display:grid; grid-template-columns:1.05fr .95fr;
    gap:40px; align-items:center;
    padding-top:72px; padding-bottom:40px;
  }
  .hero-badge{
    background:#fff; padding:8px 14px; border-radius:999px;
    box-shadow:0 6px 18px -10px rgba(33,29,51,.4);
  }
  h1{
    font-weight:800; font-size:clamp(34px,4.6vw,56px);
    margin:22px 0 0; color:var(--ink);
  }
  .hero-desc{
    font-size:17px; line-height:1.65; color:var(--muted);
    margin-top:22px; max-width:50ch;
  }
  .hero-ctas{ display:flex; gap:14px; margin-top:30px; flex-wrap:wrap; }
  .hero-socials{ display:flex; align-items:center; gap:10px; margin-top:30px; flex-wrap:wrap; }

  .hero-photo{ position:relative; display:flex; justify-content:center; }
  .hero-blob{
    position:absolute; width:280px; height:280px; border-radius:50%;
    background:radial-gradient(circle at 30% 30%,#c9b6f4,#a988ec);
    filter:blur(2px); top:8%;
  }
  .hero-img{
    position:relative; width:280px; height:340px;
    border-radius:26px; object-fit:cover; object-position:center top;
    box-shadow:0 30px 60px -24px rgba(86,54,160,.5);
  }
  .stat-card-left{
    position:absolute; left:-12px; bottom:30px;
    padding:14px 16px; border-radius:16px; animation-delay:1.2s;
  }
  .stat-card-right{
    position:absolute; right:-10px; top:22px;
    padding:12px 15px; border-radius:16px;
    display:flex; align-items:center; gap:9px; animation-delay:.5s;
  }
  .stat-card-bottom{
    position:absolute; right:-10px; bottom:-14px;
    padding:12px 15px; border-radius:16px;
    display:flex; align-items:center; gap:9px; animation-delay:.8s;
  }
  .stat-green{ font-weight:800; font-size:20px; color:#2fae74; }
  .stat-lbl{ font-size:11px; color:var(--muted); }

  /* ── INTRO ── */
  .intro{ padding:74px 0 10px; text-align:center; }
  .intro-wrap{ max-width:820px; margin:0 auto; }
  .intro h2{ font-weight:700; font-size:clamp(24px,3.2vw,36px); margin-top:18px; }
  .intro p{ font-size:16px; line-height:1.7; color:var(--muted); margin-top:20px; max-width:64ch; margin-left:auto; margin-right:auto; }

  /* ── ABOUT SPLIT ── */
  .about-sec{
    padding:84px 0;
    display:grid; grid-template-columns:.95fr 1.05fr;
    gap:56px; align-items:center;
  }
  .about-photo{ position:relative; }
  .about-deco{
    position:absolute; inset:auto auto -16px -16px;
    width:130px; height:130px; border-radius:24px;
    background:#fde7da; z-index:0;
  }
  .about-img{
    position:relative; z-index:1; width:100%;
    aspect-ratio:1/1; object-fit:cover; object-position:center top;
    border-radius:22px; display:block;
  }
  .about-badge{
    position:absolute; z-index:2; right:-14px; bottom:-18px;
    padding:16px 18px; border-radius:18px;
    display:flex; align-items:center; gap:11px;
  }
  .about-years{
    width:42px; height:42px; border-radius:12px;
    background:#e3f3ea; color:#2fae74;
    font-weight:800; font-size:16px;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .about-text h2{ font-weight:800; font-size:clamp(26px,3.4vw,40px); margin-top:16px; }
  .about-text > p{ font-size:16px; line-height:1.7; color:var(--muted); margin-top:16px; }
  .about-pillars{
    display:grid; grid-template-columns:1fr 1fr;
    gap:18px 26px; margin-top:28px;
  }
  .pillar{ display:flex; gap:11px; align-items:flex-start; }
  .pillar-check{
    width:26px; height:26px; border-radius:8px;
    background:#efe9fc; color:var(--accent);
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .pillar strong{ display:block; font-weight:700; font-size:15px; }
  .pillar span{ font-size:13px; color:var(--muted); }

  /* ── STAT BAR ── */
  .stat-bar{ padding-bottom:78px; }
  .stat-bar-card{
    display:grid; grid-template-columns:repeat(5,1fr);
    gap:20px; padding:34px 40px; border-radius:24px;
    background:linear-gradient(120deg,#fff,#faf6ff);
  }
  .stat-item{ text-align:center; }
  .stat-item+.stat-item{ border-left:1px solid #ece7f6; }
  .stat-num{ font-weight:800; font-size:36px; }
  .stat-sub{ font-size:13px; color:var(--muted); margin-top:4px; }

  /* ── ACHIEVEMENTS ── */
  .achieve-sec{ background:var(--dark); color:#fff; padding:82px 0; }
  .achieve-head{ max-width:640px; margin:0 auto 46px; text-align:center; }
  .achieve-head .tag{ color:#c3b1f5; justify-content:center; }
  .achieve-head .tag::before{ background:#c3b1f5; }
  .achieve-head h2{ font-weight:800; font-size:clamp(28px,3.8vw,44px); margin-top:14px; color:#fff; }
  .achieve-head p{ font-size:15px; color:#a59fc0; margin-top:14px; }
  .achieve-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  .achieve-card{
    background:#1f1a38; border-radius:22px; padding:30px 28px;
    transition:transform .22s, box-shadow .22s;
  }
  .achieve-card:hover{ transform:translateY(-6px); box-shadow:0 30px 60px -28px rgba(33,29,51,.5); }
  .achieve-cat{ font-size:12px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; color:#c3b1f5; }
  .achieve-num{ font-weight:800; font-size:38px; color:#7bd0a4; display:block; margin-top:14px; }
  .achieve-card h3{ font-size:17px; font-weight:700; margin-top:8px; color:#fff; }
  .achieve-card p{ font-size:14px; color:#a59fc0; margin-top:10px; line-height:1.6; }
  .achieve-row{
    margin-top:24px; background:#1f1a38; border-radius:22px;
    padding:26px 30px; display:flex; align-items:center; gap:18px; flex-wrap:wrap;
  }
  .achieve-row-ico{ background:rgba(124,92,214,.25); color:#c3b1f5; flex-shrink:0; }
  .achieve-row h3{ font-size:17px; font-weight:700; color:#fff; }
  .achieve-row p{ font-size:14px; color:#a59fc0; margin-top:5px; line-height:1.55; }

  /* ── CREDENTIALS ── */
  .creds-sec{
    background:linear-gradient(180deg,#f7f2ff,#fdeef0);
    padding:84px 0;
  }
  .creds-inner{ display:flex; flex-direction:column; gap:54px; }
  .creds-2col{ display:grid; grid-template-columns:1fr 1fr; gap:16px; margin-top:28px; }
  .creds-2col.cols-3{ grid-template-columns:repeat(3,1fr); }
  .edu-card{ padding:22px 24px; }
  .edu-head{ display:flex; justify-content:space-between; gap:10px; flex-wrap:wrap; }
  .edu-degree{ font-weight:700; font-size:17px; }
  .edu-years{ font-size:13px; color:var(--accent); font-weight:600; white-space:nowrap; }
  .edu-school{ font-size:14px; color:var(--muted); margin-top:4px; }
  .cert-card{
    padding:20px 22px; display:flex; gap:13px; align-items:flex-start;
    border-radius:22px; box-shadow:0 18px 50px -28px rgba(33,29,51,.45);
    background:#fff; transition:transform .22s, box-shadow .22s;
  }
  .cert-card:hover{ transform:translateY(-6px); box-shadow:0 30px 60px -28px rgba(33,29,51,.5); }
  .cert-ico{ width:40px; height:40px; border-radius:11px; flex-shrink:0; display:flex; align-items:center; justify-content:center; }
  .cert-name{ font-weight:700; font-size:15px; display:block; }
  .cert-issuer{ font-size:13px; color:var(--muted); display:block; margin-top:2px; }
  .cert-verify{ font-size:12px; font-weight:600; color:var(--accent); display:inline-flex; align-items:center; gap:4px; margin-top:8px; }

  /* ── TOOLS MARQUEE ── */
  .tools-sec{
    padding:54px 0; overflow:hidden;
    border-top:1px solid #f0e9f6; border-bottom:1px solid #f0e9f6;
  }
  .tools-label{ text-align:center; margin-bottom:28px; }
  .marquee-track{ overflow:hidden; }
  .marquee-inner{ display:flex; gap:54px; white-space:nowrap; animation:scrollx 26s linear infinite; font-weight:700; font-size:22px; color:#b3a8c8; }

  /* ── CONTACT CTA ── */
  .contact-sec{ background:var(--dark); color:#fff; padding:82px 0; text-align:center; }
  .contact-tag{ color:#c3b1f5; justify-content:center; }
  .contact-tag::before{ background:#c3b1f5; }
  .contact-h2{ font-weight:800; font-size:clamp(28px,4vw,46px); margin-top:16px; color:#fff; }
  .contact-desc{ font-size:16px; color:#a59fc0; margin-top:16px; max-width:50ch; line-height:1.7; margin-left:auto; margin-right:auto; }
  .contact-ctas{ display:flex; gap:14px; justify-content:center; margin-top:30px; flex-wrap:wrap; }

  /* ── RESPONSIVE ── */
  @media(max-width:900px){
    .hero-inner{ grid-template-columns:1fr; }
    .hero-photo{ display:none; }
    .stat-bar-card{ grid-template-columns:repeat(3,1fr); }
    .stat-item{ border-left:none !important; }
    .about-sec{ grid-template-columns:1fr; }
    .about-photo{ display:none; }
    .achieve-grid{ grid-template-columns:1fr; }
    .creds-2col{ grid-template-columns:1fr; }
    .creds-2col.cols-3{ grid-template-columns:1fr; }
    .about-pillars{ grid-template-columns:1fr; }
  }
  @media(max-width:600px){
    .wrap{ padding:0 16px; }
    .stat-bar-card{ padding:24px 20px; grid-template-columns:repeat(2,1fr); }
    .hero-desc{ font-size:16px; }
    .pill{ font-size:14px; padding:12px 20px; }
    .hero-ctas{ gap:10px; }
  }
</style>

<!-- ── HERO ── -->
<section id="top" class="hero">
  <div class="wrap">
    <div class="hero-inner">
      <div>
        <span class="tag hero-badge">About me</span>
        <h1>Hi, I'm Sivaraj, the SEO analyst behind <span class="em">SEO With Siva.</span></h1>
        <p class="hero-desc">SEO Analyst and AEO/GEO specialist based in Coimbatore, India, with 5+ years driving organic growth for large-scale platforms across Google, ChatGPT, Gemini, and Perplexity. Here's my story, my experience, and the credentials behind the results.</p>
        <div class="hero-ctas">
          <a href="/contact/" class="pill cta">Let's connect →</a>
          <a href="/articles/" class="pill ghost">Read my articles</a>
        </div>
        <div class="hero-socials">
          <a href="https://www.linkedin.com/in/sivaraj-seo-analyst/" target="_blank" rel="noopener" class="hsoc" style="background:#fff;padding:9px 16px;border-radius:999px;font-size:13px;font-weight:600;color:#4a4560;box-shadow:0 4px 12px -8px rgba(33,29,51,.5)">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="#0a66c2"><path d="M4.98 3.5A2.5 2.5 0 002.5 6a2.5 2.5 0 105 0 2.5 2.5 0 00-2.52-2.5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21H18.6v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H11z"/></svg>
            LinkedIn
          </a>
          <a href="https://medium.com/@sivaraj-c" target="_blank" rel="noopener" class="hsoc" style="background:#fff;padding:9px 16px;border-radius:999px;font-size:13px;font-weight:600;color:#4a4560;box-shadow:0 4px 12px -8px rgba(33,29,51,.5)">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="#191919"><path d="M13.54 12a6.8 6.8 0 01-6.77 6.82A6.8 6.8 0 010 12a6.8 6.8 0 016.77-6.82A6.8 6.8 0 0113.54 12zM20.96 12c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42S20.96 8.46 20.96 12zM24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
            Medium
          </a>
          <a href="https://www.quora.com/profile/Sivaraj-29" target="_blank" rel="noopener" class="hsoc" style="background:#fff;padding:9px 16px;border-radius:999px;font-size:13px;font-weight:600;color:#4a4560;box-shadow:0 4px 12px -8px rgba(33,29,51,.5)">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="#b92b27"><path d="M12.74 16.66c-.53-1.05-1.16-2.1-2.5-2.1-.26 0-.52.04-.75.14l-.44-.9c.53-.46 1.4-.83 2.53-.83 1.75 0 2.65 1.06 3.36 2.4.42-.9.6-2.06.6-3.4 0-3.34-1.05-5.04-3.54-5.04-2.46 0-3.5 1.7-3.5 5.04s1.04 5.02 3.5 5.02c.27 0 .52-.02.76-.07zm1.03 1.9c-.34.08-.7.12-1.07.12-3.83 0-6.75-2.98-6.75-6.97C5.95 7.7 8.87 4.7 12.7 4.7c3.88 0 6.77 2.98 6.77 6.9 0 2.45-1.12 4.55-2.92 5.76.5.72 1.02 1.2 1.75 1.2.8 0 1.12-.62 1.18-1.1h1.6c-.07 1.02-.6 3.13-3.2 3.13-1.98 0-3.02-1.15-4.1-2.03z"/></svg>
            Quora
          </a>
          <a href="https://www.reddit.com/user/Sivaraj_C/" target="_blank" rel="noopener" class="hsoc" style="background:#fff;padding:9px 16px;border-radius:999px;font-size:13px;font-weight:600;color:#4a4560;box-shadow:0 4px 12px -8px rgba(33,29,51,.5)">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="#ff4500"><path d="M22 12.06c0-1.1-.9-2-2-2-.53 0-1 .2-1.36.54-1.34-.9-3.1-1.46-5.04-1.53l.86-3.9 2.72.6a1.43 1.43 0 102.86-.1 1.43 1.43 0 00-2.7-.65l-3.05-.68a.35.35 0 00-.42.27l-.96 4.36c-1.97.06-3.75.62-5.1 1.53A2 2 0 002 12.06c0 .78.45 1.45 1.1 1.78a3.6 3.6 0 00-.05.6c0 3.06 3.56 5.54 7.95 5.54s7.95-2.48 7.95-5.54c0-.2-.02-.4-.05-.6.65-.33 1.1-1 1.1-1.78zM7.5 13.5a1.43 1.43 0 112.86 0 1.43 1.43 0 01-2.86 0zm7.9 3.6c-.98.98-3.6.98-4.58 0a.35.35 0 01.5-.5c.68.68 2.9.68 3.58 0a.35.35 0 01.5.5zm-.22-2.17a1.43 1.43 0 110-2.86 1.43 1.43 0 010 2.86z"/></svg>
            Reddit
          </a>
        </div>
      </div>
      <div class="hero-photo">
        <div class="hero-blob"></div>
        <img class="hero-img floaty" src="/images/profile-about.webp" alt="C. Sivaraj" width="500" height="500" loading="eager" fetchpriority="high" />
        <div class="card floaty stat-card-left">
          <div class="stat-green">5+</div>
          <div class="stat-lbl">years in SEO &amp; AI search</div>
        </div>
        <div class="card floaty stat-card-right">
          <div class="ico" style="width:38px;height:38px;border-radius:11px;background:#fbe6ef;color:var(--cta)">
            <svg viewBox="0 0 24 24" width="20" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="4 15 10 9 14 13 20 5"/></svg>
          </div>
          <div>
            <div style="font-weight:700;font-size:13px">1M+</div>
            <div class="stat-lbl">Bing AI citations</div>
          </div>
        </div>
        <div class="card floaty stat-card-bottom">
          <div class="ico" style="width:38px;height:38px;border-radius:11px;background:#e8edfb;color:#4a63c9">
            <svg viewBox="0 0 24 24" width="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/></svg>
          </div>
          <div>
            <div style="font-weight:700;font-size:13px">12M+</div>
            <div class="stat-lbl">Google AI citations</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="clouds"></div>
</section>

<!-- ── INTRO / PHILOSOPHY ── -->
<section class="intro">
  <div class="wrap intro-wrap">
    <span class="tag" style="display:inline-flex;justify-content:center">My philosophy</span>
    <h2>SEO should be transparent, technical, and built for how search works <em>now</em>.</h2>
    <p>I believe in giving businesses the knowledge and tools to compete effectively online, not black-box tactics, but transparent, actionable guidance that delivers measurable results across both traditional rankings and AI citations.</p>
  </div>
</section>

<!-- ── ABOUT SPLIT ── -->
<div id="story" class="about-sec wrap">
  <div class="about-photo">
    <div class="about-deco"></div>
    <img src="/images/profile-story.webp" alt="C. Sivaraj" width="500" height="500" loading="lazy" class="about-img" />
    <div class="card about-badge">
      <div class="about-years">5+</div>
      <div style="font-size:12px;color:var(--muted);line-height:1.3"><b style="color:var(--ink)">Years</b><br>in SEO &amp; AI search</div>
    </div>
  </div>
  <div class="about-text">
    <span class="tag">My story</span>
    <h2>An MBA and a computer science degree, built into one <span class="em">SEO approach.</span></h2>
    <p>
      I'm based in Coimbatore, India, and hold an MBA in Marketing from Kongu Engineering College
      and a BSc in Computer Science from SNR Sons College, a combination that's shaped how I
      approach SEO: half technical execution, half business strategy. As search fragmented across
      Google, ChatGPT, Gemini, and Perplexity, I shifted from pure ranking-focused SEO toward AEO
      and GEO, helping brands earn visibility not just in blue links, but directly inside AI
      Overviews and AI-generated answers.
    </p>
    <div class="about-pillars">
      <div class="pillar">
        <span class="pillar-check"><svg viewBox="0 0 24 24" width="15" fill="none" stroke="currentColor" stroke-width="3"><polyline points="5 13 10 18 19 6"/></svg></span>
        <div><strong>Transparency</strong><span>Clear communication about what works.</span></div>
      </div>
