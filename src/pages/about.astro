---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { safeJsonLd } from '../utils/schema';

const title = 'About C. Sivaraj – SEO Analyst & AEO / GEO Specialist';
const description = "I'm C. Sivaraj, an SEO Analyst and AEO/GEO specialist with 7+ years of enterprise SEO experience helping brands rank in Google, ChatGPT, and Perplexity.";
const keywords = 'C. Sivaraj, SEO analyst, AEO, GEO, AI search optimization, enterprise SEO';

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: title,
  description,
  url: 'https://www.seowithsiva.com/about/',
  mainEntity: { '@id': 'https://www.seowithsiva.com/#person' },
};
---

<BaseLayout {title} {description} {keywords} author="C. Sivaraj">

<Fragment slot="head">
  <script type="application/ld+json" set:html={safeJsonLd(aboutPageSchema)} />
</Fragment>

<style>
  h1, h2, h3 { margin: 0; letter-spacing: -.025em; line-height: 1.15; font-weight: 600; color: var(--ink); }
  p { margin: 0; }
  a { color: inherit; text-decoration: none; }

  .wrap { max-width: 1200px; margin: 0 auto; padding: 0 32px; }
  .em { color: var(--primary); }
  .ulink { background: linear-gradient(var(--primary), var(--primary)) 0 92%/100% 3px no-repeat; }

  .pill {
    display: inline-flex; align-items: center; gap: 8px;
    border-radius: 999px; font-weight: 600; font-size: 13.5px;
    padding: 11px 20px; transition: transform .15s, background .15s, border-color .15s, color .15s;
    cursor: pointer;
  }
  .pill:hover { transform: translateY(-1px); }
  .cta { background: var(--primary); color: #fff; box-shadow: 0 8px 20px -8px rgba(24,119,242,.7); }
  .cta:hover { background: var(--primary-dark); }
  .ghost { background: #fff; color: var(--ink); border: 1px solid var(--border); }
  .ghost:hover { border-color: var(--primary); color: var(--primary); }

  .tag { display: inline-block; font-size: 12px; color: var(--muted); letter-spacing: .02em; }
  .tag::before { content: '['; }
  .tag::after { content: ']'; }

  .card { background: #fff; border-radius: 20px; transition: transform .2s, box-shadow .2s; }
  .ico { width: 54px; height: 54px; border-radius: 15px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }

  .hsoc {
    display: inline-flex; align-items: center; gap: 8px;
    background: #fff; border: 1px solid var(--border);
    padding: 8px 14px; border-radius: 999px;
    font-size: 12.5px; font-weight: 600; color: var(--ink-light);
    transition: border-color .15s, color .15s;
  }
  .hsoc:hover { border-color: var(--primary); color: var(--primary); }

  @keyframes scrollx { from { transform: translateX(0) } to { transform: translateX(-50%) } }
  .clouds { display: none; }

  /* ── HERO ── */
  .hero { position: relative; overflow: hidden; padding: 24px 0 0; }
  .hero-inner {
    display: grid; grid-template-columns: 1.1fr .9fr;
    gap: 48px; align-items: center;
    background: var(--surface); border-radius: 28px;
    padding: 56px;
  }
  h1 { font-size: clamp(32px, 4.2vw, 52px); line-height: 1.12; margin-top: 14px; }
  .hero-desc { font-size: 15px; line-height: 1.7; color: var(--muted); margin-top: 20px; max-width: 52ch; }
  .hero-ctas { display: flex; gap: 12px; margin-top: 28px; flex-wrap: wrap; }
  .hero-socials { display: flex; align-items: center; gap: 8px; margin-top: 24px; flex-wrap: wrap; }

  .hero-photo { position: relative; display: flex; justify-content: center; }
  .hero-blob {
    position: absolute; inset: 10% 5% -10%;
    background: radial-gradient(circle, rgba(24,119,242,.28) 0%, rgba(24,119,242,.08) 45%, transparent 70%);
  }
  .hero-img {
    position: relative; width: 100%; max-width: 360px; aspect-ratio: 1;
    border-radius: 24px; object-fit: cover; object-position: center top;
  }
  .stat-card-left, .stat-card-right, .stat-card-bottom {
    position: absolute; padding: 12px 15px; border-radius: 16px;
    box-shadow: 0 18px 40px -20px rgba(17,20,24,.35);
  }
  .stat-card-left { left: 0; bottom: 36px; }
  .stat-card-right { right: 0; top: 24px; display: flex; align-items: center; gap: 9px; }
  .stat-card-bottom { right: 8px; bottom: -14px; display: flex; align-items: center; gap: 9px; }
  .stat-green { font-weight: 700; font-size: 22px; color: var(--primary); letter-spacing: -.03em; }
  .stat-lbl { font-size: 11px; color: var(--muted); }

  /* ── INTRO ── */
  .intro { padding: 110px 0 0; text-align: center; }
  .intro-wrap { max-width: 820px; margin: 0 auto; }
  .intro h2 { font-size: clamp(26px, 3.2vw, 38px); margin-top: 14px; }
  .intro h2 em { font-style: normal; color: var(--primary); }
  .intro p { font-size: 15px; line-height: 1.7; color: var(--muted); margin: 18px auto 0; max-width: 62ch; }

  /* ── STORY ── */
  .about-sec {
    margin-top: 110px; padding-top: 0; padding-bottom: 0;
    display: grid; grid-template-columns: .9fr 1.1fr;
    gap: 56px; align-items: center;
  }
  .about-photo { position: relative; }
  .about-deco { display: none; }
  .about-img { width: 100%; aspect-ratio: 1; object-fit: cover; object-position: center top; border-radius: 24px; display: block; }
  .about-badge {
    position: absolute; right: -14px; bottom: -18px;
    padding: 14px 16px; border-radius: 18px;
    display: flex; align-items: center; gap: 11px;
    box-shadow: 0 18px 40px -20px rgba(17,20,24,.35);
  }
  .about-years {
    width: 42px; height: 42px; border-radius: 12px;
    background: var(--primary); color: #fff;
    font-weight: 700; font-size: 16px;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .about-text h2 { font-size: clamp(26px, 3.2vw, 40px); margin-top: 12px; }
  .about-text > p { font-size: 15px; line-height: 1.75; color: var(--muted); margin-top: 18px; }
  .about-pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 28px; }
  .pillar { display: flex; gap: 11px; align-items: flex-start; background: var(--surface); border-radius: 16px; padding: 14px 16px; }
  .pillar-check {
    width: 26px; height: 26px; border-radius: 8px;
    background: var(--primary); color: #fff;
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
  }
  .pillar strong { display: block; font-weight: 600; font-size: 14px; }
  .pillar span { font-size: 12.5px; color: var(--muted); }

  /* ── STAT BAR ── */
  .stat-bar { padding-top: 90px; }
  .stat-bar-card {
    display: grid; grid-template-columns: repeat(5, 1fr);
    gap: 20px; padding: 34px 40px; border-radius: 24px;
    background: var(--surface);
  }
  .stat-item { text-align: center; }
  .stat-item + .stat-item { border-left: 1px solid var(--border); }
  .stat-num { font-weight: 700; font-size: 34px; letter-spacing: -.04em; color: var(--ink); }
  .stat-num span { color: var(--primary) !important; }
  .stat-sub { font-size: 12.5px; color: var(--muted); margin-top: 4px; }

  /* ── ACHIEVEMENTS ── */
  .achieve-sec { padding-top: 110px; }
  .achieve-sec > .wrap > .achieve-inner { background: var(--dark); color: #fff; border-radius: 28px; padding: 64px 56px; position: relative; overflow: hidden; }
  .achieve-inner::after {
    content: ''; position: absolute; right: -120px; top: -160px; width: 420px; height: 420px;
    background: radial-gradient(circle, rgba(24,119,242,.35), transparent 65%); pointer-events: none;
  }
  .achieve-head { max-width: 640px; margin: 0 auto 44px; text-align: center; position: relative; }
  .achieve-head .tag { color: #8fb8ff; }
  .achieve-head h2 { font-size: clamp(28px, 3.6vw, 42px); margin-top: 12px; color: #fff; }
  .achieve-head p { font-size: 14.5px; color: #9fb2cc; margin-top: 14px; line-height: 1.6; }
  .achieve-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; position: relative; }
  .achieve-card { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); border-radius: 20px; padding: 28px 26px; }
  .achieve-cat { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #8fb8ff; }
  .achieve-num { font-weight: 700; font-size: 40px; letter-spacing: -.045em; color: #fff; display: block; margin-top: 14px; }
  .achieve-card h3 { font-size: 16px; margin-top: 6px; color: #fff; }
  .achieve-card p { font-size: 13.5px; color: #9fb2cc; margin-top: 10px; line-height: 1.65; }
  .achieve-row {
    position: relative; margin-top: 20px;
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); border-radius: 20px;
    padding: 24px 28px; display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
  }
  .achieve-row-ico { background: rgba(24,119,242,.25); color: #8fb8ff; }
  .achieve-row h3 { font-size: 16px; color: #fff; }
  .achieve-row p { font-size: 13.5px; color: #9fb2cc; margin-top: 5px; line-height: 1.6; }

  /* ── CREDENTIALS ── */
  .creds-sec { padding-top: 110px; }
  .creds-inner { display: flex; flex-direction: column; gap: 56px; }
  .creds-inner h2 { font-size: clamp(26px, 3vw, 36px); margin-top: 10px; }
  .creds-2col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 26px; }
  .creds-2col.cols-3 { grid-template-columns: repeat(3, 1fr); }
  .edu-card { padding: 24px 26px; background: var(--surface); }
  .edu-head { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
  .edu-degree { font-weight: 600; font-size: 16px; }
  .edu-years { font-size: 12.5px; color: var(--primary); font-weight: 600; white-space: nowrap; }
  .edu-school { font-size: 13.5px; color: var(--muted); margin-top: 4px; }
  .cert-card {
    padding: 22px 24px; display: flex; gap: 13px; align-items: flex-start;
    border-radius: 20px; background: var(--surface); transition: transform .2s, box-shadow .2s;
  }
  a.cert-card:hover { transform: translateY(-3px); box-shadow: 0 18px 40px -24px rgba(17,20,24,.35); }
  .cert-ico { width: 40px; height: 40px; border-radius: 11px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: #fff !important; color: var(--primary) !important; }
  .cert-name { font-weight: 600; font-size: 14.5px; display: block; }
  .cert-issuer { font-size: 12.5px; color: var(--muted); display: block; margin-top: 2px; }
  .cert-verify { font-size: 12px; font-weight: 600; color: var(--primary); display: inline-flex; align-items: center; gap: 4px; margin-top: 8px; }

  /* ── TOOLS MARQUEE ── */
  .tools-sec { padding: 90px 0 0; overflow: hidden; }
  .tools-label { text-align: center; margin-bottom: 24px; }
  .marquee-track { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .marquee-inner { display: flex; gap: 12px; white-space: nowrap; animation: scrollx 34s linear infinite; width: max-content; }
  .marquee-inner span { font-size: 14px; font-weight: 600; color: var(--ink-light); background: var(--surface); border-radius: 999px; padding: 10px 18px; }
  .marquee-inner span:nth-child(even) { display: none; }

  /* ── CONTACT CTA ── */
  .contact-sec { padding-top: 110px; }
  .contact-sec > .wrap > .contact-inner {
    background: linear-gradient(180deg, var(--primary-light), var(--surface));
    border-radius: 28px; padding: 64px 32px; text-align: center;
  }
  .contact-h2 { font-size: clamp(28px, 3.6vw, 42px); margin-top: 12px; }
  .contact-h2 span { color: var(--primary) !important; }
  .contact-desc { font-size: 14.5px; color: var(--muted); margin: 16px auto 0; max-width: 50ch; line-height: 1.7; }
  .contact-ctas { display: flex; gap: 12px; justify-content: center; margin-top: 28px; flex-wrap: wrap; }

  /* ── RESPONSIVE ── */
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; padding: 36px 28px 48px; }
    .hero-photo { max-width: 380px; margin: 8px auto 0; }
    .stat-bar-card { grid-template-columns: repeat(3, 1fr); row-gap: 28px; }
    .stat-item { border-left: none !important; }
    .about-sec { grid-template-columns: 1fr; }
    .about-photo { max-width: 420px; }
    .achieve-grid, .creds-2col, .creds-2col.cols-3, .about-pillars { grid-template-columns: 1fr; }
    .achieve-sec > .wrap > .achieve-inner { padding: 44px 24px; }
  }
  @media (max-width: 600px) {
    .wrap { padding: 0 16px; }
    .hero-inner { padding: 28px 20px 44px; border-radius: 22px; }
    .stat-bar-card { padding: 26px 18px; grid-template-columns: repeat(2, 1fr); }
    .intro, .achieve-sec, .creds-sec, .contact-sec { padding-top: 80px; }
    .about-sec { margin-top: 80px; }
    .stat-bar { padding-top: 70px; }
    .about-badge { right: 10px; }
    .stat-card-right { top: -26px; right: -6px; }
  }
</style>

<!-- ── HERO ── -->
<section id="top" class="hero">
  <div class="wrap">
    <div class="hero-inner">
      <div>
        <Breadcrumb items={[{ name: 'About', href: '/about/' }]} />
        <span class="tag hero-badge">About me</span>
        <h1>Hi, I'm Sivaraj, the SEO analyst behind <span class="em">SEO With Siva.</span></h1>
        <p class="hero-desc">SEO Analyst and AEO/GEO specialist based in Coimbatore, India, with 7+ years driving organic growth for large-scale platforms across Google, ChatGPT, Gemini, and Perplexity. Here's my story, my experience, and the credentials behind the results.</p>
        <div class="hero-ctas">
          <a href="/contact/" class="pill cta">Let's connect →</a>
          <a href="/blog/" class="pill ghost">Read my blog</a>
        </div>
        <div class="hero-socials">
          <a href="https://www.linkedin.com/in/sivaraj-seo-analyst/" target="_blank" rel="noopener" class="hsoc">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="#0a66c2"><path d="M4.98 3.5A2.5 2.5 0 002.5 6a2.5 2.5 0 105 0 2.5 2.5 0 00-2.52-2.5zM3 9h4v12H3zM10 9h3.8v1.7h.05c.53-.95 1.83-1.95 3.77-1.95 4.03 0 4.78 2.5 4.78 5.76V21H18.6v-5.3c0-1.26-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H11z"/></svg>
            LinkedIn
          </a>
          <a href="https://x.com/seowithsiva" target="_blank" rel="noopener" class="hsoc">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="#111418"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            X
          </a>
          <a href="https://www.reddit.com/user/Sivaraj_C/" target="_blank" rel="noopener" class="hsoc">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="#ff4500"><path d="M22 12.06c0-1.1-.9-2-2-2-.53 0-1 .2-1.36.54-1.34-.9-3.1-1.46-5.04-1.53l.86-3.9 2.72.6a1.43 1.43 0 102.86-.1 1.43 1.43 0 00-2.7-.65l-3.05-.68a.35.35 0 00-.42.27l-.96 4.36c-1.97.06-3.75.62-5.1 1.53A2 2 0 002 12.06c0 .78.45 1.45 1.1 1.78a3.6 3.6 0 00-.05.6c0 3.06 3.56 5.54 7.95 5.54s7.95-2.48 7.95-5.54c0-.2-.02-.4-.05-.6.65-.33 1.1-1 1.1-1.78zM7.5 13.5a1.43 1.43 0 112.86 0 1.43 1.43 0 01-2.86 0zm7.9 3.6c-.98.98-3.6.98-4.58 0a.35.35 0 01.5-.5c.68.68 2.9.68 3.58 0a.35.35 0 01.5.5zm-.22-2.17a1.43 1.43 0 110-2.86 1.43 1.43 0 010 2.86z"/></svg>
            Reddit
          </a>
          <a href="https://www.instagram.com/seowithsiva/" target="_blank" rel="noopener" class="hsoc">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style="color:#e1306c"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 3.25.15 4.77 1.69 4.92 4.92.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.15 3.23-1.66 4.77-4.92 4.92-1.27.06-1.64.07-4.85.07s-3.58-.01-4.85-.07c-3.26-.15-4.77-1.7-4.92-4.92-.06-1.27-.07-1.64-.07-4.85s.01-3.58.07-4.85C2.38 3.92 3.9 2.38 7.15 2.23 8.42 2.17 8.8 2.16 12 2.16zM12 0C8.74 0 8.33.01 7.05.07 2.7.27.27 2.69.07 7.05.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.2 4.36 2.62 6.78 6.98 6.98C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c4.35-.2 6.78-2.62 6.98-6.98.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.2-4.35-2.62-6.78-6.98-6.98C15.67.01 15.26 0 12 0zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.4-11.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88z"/></svg>
            Instagram
          </a>
          <a href="https://wa.link/l9kdx1" target="_blank" rel="noopener" class="hsoc">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" style="color:#25d366"><path d="M17.5 14.4c-.3-.1-1.6-.8-1.9-.9-.2-.1-.4-.1-.6.1-.2.3-.7.9-.8 1-.2.2-.3.2-.5.1-.3-.1-1.2-.4-2.2-1.4-.8-.7-1.4-1.6-1.5-1.9-.2-.3 0-.4.1-.6l.4-.4c.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5-.1-.1-.6-1.4-.8-1.9-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.3-.2.3-.9.9-.9 2.1 0 1.2.9 2.4 1 2.6.1.2 1.8 2.8 4.5 3.9.6.3 1.1.4 1.5.5.6.2 1.2.2 1.6.1.5-.1 1.6-.6 1.8-1.3.2-.6.2-1.2.2-1.3-.1-.2-.3-.2-.5-.3z"/><path d="M12 2a10 10 0 00-8.5 15.2L2 22l4.9-1.3A10 10 0 1012 2zm0 18.2c-1.6 0-3.1-.4-4.4-1.2l-.3-.2-3.1.8.8-3-.2-.3A8.2 8.2 0 1112 20.2z"/></svg>
            WhatsApp
          </a>
        </div>
      </div>
      <div class="hero-photo">
        <div class="hero-blob"></div>
        <img class="hero-img" src="/images/profile-about.webp" alt="C. Sivaraj" width="500" height="500" loading="eager" fetchpriority="high" />
        <div class="card stat-card-left">
          <div class="stat-green">5+</div>
          <div class="stat-lbl">years in SEO &amp; AI search</div>
        </div>
        <div class="card stat-card-right">
          <div class="ico" style="width:38px;height:38px;border-radius:11px;background:#e8f1fe;color:var(--cta)">
            <svg viewBox="0 0 24 24" width="20" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="4 15 10 9 14 13 20 5"/></svg>
          </div>
          <div>
            <div style="font-weight:700;font-size:13px">1M+</div>
            <div class="stat-lbl">Bing AI citations</div>
          </div>
        </div>
        <div class="card stat-card-bottom">
          <div class="ico" style="width:38px;height:38px;border-radius:11px;background:#e8f1fe;color:#1877f2">
            <svg viewBox="0 0 24 24" width="20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8L12 3z"/></svg>
          </div>
          <div>
            <div style="font-weight:700;font-size:13px">12M+</div>
            <div class="stat-lbl">Google AI citations</div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="clouds"></div>
</section>

<!-- ── INTRO / PHILOSOPHY ── -->
<section class="intro">
  <div class="wrap intro-wrap">
    <span class="tag" style="display:inline-flex;justify-content:center">My philosophy</span>
    <h2>SEO should be transparent, technical, and built for how search works <em>now</em>.</h2>
    <p>I believe in giving businesses the knowledge and tools to compete effectively online, not black-box tactics, but transparent, actionable guidance that delivers measurable results across both traditional rankings and AI citations.</p>
  </div>
</section>

<!-- ── ABOUT SPLIT ── -->
<div id="story" class="about-sec wrap">
  <div class="about-photo">
    <div class="about-deco"></div>
    <img src="/images/profile-story.webp" alt="C. Sivaraj" width="500" height="500" loading="lazy" class="about-img" />
    <div class="card about-badge">
      <div class="about-years">5+</div>
      <div style="font-size:12px;color:var(--muted);line-height:1.3"><b style="color:var(--ink)">Years</b><br>in SEO &amp; AI search</div>
    </div>
  </div>
  <div class="about-text">
    <span class="tag">My story</span>
    <h2>An MBA and a computer science degree, built into one <span class="em">SEO approach.</span></h2>
    <p>
      I'm based in Coimbatore, India, and hold an MBA in Marketing from Kongu Engineering College
      and a BSc in Computer Science from SNR Sons College, a combination that's shaped how I
      approach SEO: half technical execution, half business strategy. As search fragmented across
      Google, ChatGPT, Gemini, and Perplexity, I shifted from pure ranking-focused SEO toward AEO
